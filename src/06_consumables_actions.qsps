!! CONSUMABLE ACTION HANDLER
if $ARGS[0] = 'consumables':
	gs 'mod_GLQS_main', 'consumables_data'
	glqs_amt = iif(ARGS[1] > 0, ARGS[1], 10000)
	glqs_con_i = 0
:glqs_consumables_bulk_loop
	if glqs_con_i >= glqs_con_n: jump 'glqs_consumables_unique_start'
	if $glqs_con_kind[glqs_con_i] = 'bulk': mc_inventory[$glqs_con_key[glqs_con_i]] = glqs_amt
	glqs_con_i += 1
	jump 'glqs_consumables_bulk_loop'
:glqs_consumables_unique_start
	glqs_con_i = 0
:glqs_consumables_unique_loop
	if glqs_con_i >= glqs_con_n: jump 'glqs_consumables_done'
	if $glqs_con_kind[glqs_con_i] = 'unique': mc_inventory[$glqs_con_key[glqs_con_i]] = 1
	glqs_con_i += 1
	jump 'glqs_consumables_unique_loop'
:glqs_consumables_done
	killvar 'glqs_amt'
	killvar 'glqs_con_i'
end
