!! RELATIONSHIPS SUBMENU
if $ARGS[0] = 'rel_menu':
	gs 'mod_GLQS_main', 'rel_category_labels'
	gs 'mod_GLQS_main', 'rel_roster'
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Relationships</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'rel_menu'
	'Values 0-100. Max sets every listed character to 100, whether or not you have met them yet. Each category has its own [Max] link.'
	*nl
	'Filter: '
	*p $iif(glqs_rel_filter = 0, '<b>All</b>', '<a href="exec: glqs_rel_filter = 0 & gt ''mod_GLQS_main'', ''rel_menu''">All</a>')
	*p ' | '
	*p $iif(glqs_rel_filter = 1, '<b>Male Only</b>', '<a href="exec: glqs_rel_filter = 1 & gt ''mod_GLQS_main'', ''rel_menu''">Male Only</a>')
	*p ' | '
	*pl $iif(glqs_rel_filter = 2, '<b>Female Only</b>', '<a href="exec: glqs_rel_filter = 2 & gt ''mod_GLQS_main'', ''rel_menu''">Female Only</a>')
	*nl

	$glqs_tbl = '<table width="80%" cellpadding=3>'
	$glqs_tbl += '<tr><th align="left">Name</th><th align="left">Value</th><th align="left">Status</th><th align="left"></th></tr>'
	$glqs_rl_prevcat = ''
	$glqs_rl_pendhdr = ''
	glqs_rl_i = 0
	:glqs_rel_render_loop
	if glqs_rl_i < arrsize('$glqs_npc'):
		gs 'mod_GLQS_main', 'split_row', $glqs_npc[glqs_rl_i]
		$glqs_rp_cat = $glqs_field[0]
		glqs_rp_gender = val($glqs_field[1])
		$glqs_rp_key = $glqs_field[2]
		$glqs_rp_name = $glqs_field[3]
		if $glqs_rp_cat <> $glqs_rl_prevcat:
			!! Held back rather than emitted here - under a gender filter a category
			!! can match zero rows, which used to leave a bare heading and a [Max]
			!! link with nothing under it. Outcasts and Gadukino are all male, so
			!! Female Only showed exactly that.
			$glqs_rl_pendhdr = '<tr><td colspan="4"><b>' + $glqs_cat_label[$glqs_rp_cat] + '</b> <a href="exec: gs ''mod_GLQS_main'', ''max_category'', ''' + $glqs_rp_cat + ''' & gt ''mod_GLQS_main'', ''rel_menu''">[Max]</a></td></tr>'
			$glqs_rl_prevcat = $glqs_rp_cat
		end
		if glqs_rel_filter = 0 or glqs_rel_filter = glqs_rp_gender:
			if $glqs_rl_pendhdr <> '':
				$glqs_tbl += $glqs_rl_pendhdr
				$glqs_rl_pendhdr = ''
			end
			$glqs_rl_status = $npc_rel_type[$glqs_rp_key]
			if $glqs_rl_status = '': $glqs_rl_status = '-'
			$glqs_tbl += '<tr><td>' + $glqs_rp_name + '</td><td>' + npc_rel[$glqs_rp_key] + '</td><td>' + $glqs_rl_status + '</td><td>' + $func('mod_GLQS_main', 'rel_actions', $glqs_rp_key, glqs_rp_gender) + '</td></tr>'
		end
		glqs_rl_i += 1
		jump 'glqs_rel_render_loop'
	end

	!! Procedurally-generated NPCs (B#-id, promoted via npcpreservec) have no
	!! static roster entry - $npc_index is the base games own enumerable list
	!! of them (npcgeneratec.qsrc/npcpreservec.qsrc), so scan it here. Only
	!! entries with an active relationship status are shown, not every
	!! throwaway background character the game has ever spawned.
	$glqs_rl_gen_rows = ''
	glqs_rl_i = 0
	glqs_rl_total = arrsize('$npc_index')
	:glqs_gen_scan_loop
	if glqs_rl_i < glqs_rl_total:
		$glqs_rl_gid = $npc_index[glqs_rl_i]
		if $mid($glqs_rl_gid, 1, 1) = 'B' and $npc_rel_type[$glqs_rl_gid] <> '':
			glqs_rl_ggender = npc_gender[$glqs_rl_gid] + 1
			if glqs_rel_filter = 0 or glqs_rel_filter = glqs_rl_ggender:
				$glqs_rl_gen_rows += '<tr><td>' + $npc_usedname[$glqs_rl_gid] + '</td><td>' + npc_rel[$glqs_rl_gid] + '</td><td>' + $npc_rel_type[$glqs_rl_gid] + '</td><td>' + $func('mod_GLQS_main', 'rel_actions', $glqs_rl_gid, glqs_rl_ggender) + '</td></tr>'
			end
		end
		glqs_rl_i += 1
		jump 'glqs_gen_scan_loop'
	end
	if $glqs_rl_gen_rows <> '':
		$glqs_tbl += '<tr><td colspan="4"><b>Generated NPCs (this save)</b> <a href="exec: gs ''mod_GLQS_main'', ''max_generated'' & gt ''mod_GLQS_main'', ''rel_menu''">[Max]</a></td></tr>'
		$glqs_tbl += $glqs_rl_gen_rows
	end

	$glqs_tbl += '</table>'
	$glqs_tbl
	killvar '$glqs_tbl'
	*nl

	killvar 'glqs_rl_i'
	killvar 'glqs_rl_total'
	killvar 'glqs_rl_ggender'
	killvar '$glqs_rl_gid'
	killvar '$glqs_rl_gen_rows'
	killvar '$glqs_rl_prevcat'
	killvar '$glqs_rl_pendhdr'
	killvar '$glqs_rl_status'
	killvar '$glqs_rp_cat'
	killvar 'glqs_rp_gender'
	killvar '$glqs_rp_key'
	killvar '$glqs_rp_name'
	killvar '$glqs_field'
	killvar '$glqs_npc'
	killvar '$glqs_cat_label'

	act 'Max All (filtered)':
		gs 'mod_GLQS_main', 'max_category', ''
		gs 'mod_GLQS_main', 'max_generated'
		gt 'mod_GLQS_main', 'rel_menu'
	end

	act 'Trigger Random Lover Encounter (Male)': gt 'dateM', 'start'
	act 'Trigger Random Lover Encounter (Female)': gt 'dateF', 'start'

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end


if $ARGS[0] = 'rel_actions':
	!! ARGS[1] = npc id, ARGS[2] = gender (1 male, 2 female). Returns the
	!! Marry/Divorce/Status links for one table row.
	!! Marriage is one husband and one wife at a time, tracked by the games
	!! own $husID/$wifID globals (lover.qsrc) - only offer Marry while that
	!! slot is empty, and only offer Divorce to whoever currently holds it, so
	!! this can never desync those globals from $npc_rel_type by pointing two
	!! NPCs at the same slot.
	$result = ''
	if ARGS[2] = 1:
		if $npc_rel_type[$ARGS[1]] = 'husband':
			$result = '<a href="exec: gs ''lover'', ''remove_husband'' & gt ''mod_GLQS_main'', ''rel_menu''">Divorce</a> | '
		elseif $husID = '':
			$result = '<a href="exec: gs ''lover'', ''add_husband'', ''' + $ARGS[1] + ''' & gt ''mod_GLQS_main'', ''rel_menu''">Marry</a> | '
		end
	elseif ARGS[2] = 2:
		if $npc_rel_type[$ARGS[1]] = 'wife':
			$result = '<a href="exec: gs ''lover'', ''remove_wife'' & gt ''mod_GLQS_main'', ''rel_menu''">Divorce</a> | '
		elseif $wifID = '':
			$result = '<a href="exec: gs ''lover'', ''add_wife'', ''' + $ARGS[1] + ''' & gt ''mod_GLQS_main'', ''rel_menu''">Marry</a> | '
		end
	end
	$result += '<a href="exec: gt ''mod_GLQS_main'', ''rel_status'', ''' + $ARGS[1] + '''">Status</a>'
end


if $ARGS[0] = 'max_category':
	!! ARGS[1] = category key, or an empty string for every category (the
	!! same convention store_buy uses). Respects the gender filter.
	$glqs_mc_target = $ARGS[1]
	gs 'mod_GLQS_main', 'rel_roster'
	glqs_mc_i = 0
	:glqs_rel_maxcat_loop
	if glqs_mc_i < arrsize('$glqs_npc'):
		!! Row format is category|gender|npc_rel_key|display_name.
		gs 'mod_GLQS_main', 'split_row', $glqs_npc[glqs_mc_i]
		if $glqs_mc_target = '' or $glqs_field[0] = $glqs_mc_target:
			if glqs_rel_filter = 0 or glqs_rel_filter = val($glqs_field[1]):
				npc_rel[$glqs_field[2]] = 100
			end
		end
		glqs_mc_i += 1
		jump 'glqs_rel_maxcat_loop'
	end
	killvar 'glqs_mc_i'
	killvar '$glqs_mc_target'
	killvar '$glqs_field'
	killvar '$glqs_npc'
end


if $ARGS[0] = 'max_generated':
	glqs_mg_i = 0
	glqs_mg_total = arrsize('$npc_index')
	:glqs_maxgen_loop
	if glqs_mg_i < glqs_mg_total:
		$glqs_mg_id = $npc_index[glqs_mg_i]
		if $mid($glqs_mg_id, 1, 1) = 'B' and $npc_rel_type[$glqs_mg_id] <> '':
			glqs_mg_gender = npc_gender[$glqs_mg_id] + 1
			if glqs_rel_filter = 0 or glqs_rel_filter = glqs_mg_gender:
				npc_rel[$glqs_mg_id] = 100
			end
		end
		glqs_mg_i += 1
		jump 'glqs_maxgen_loop'
	end
	killvar 'glqs_mg_i'
	killvar 'glqs_mg_total'
	killvar 'glqs_mg_gender'
	killvar '$glqs_mg_id'
end


if $ARGS[0] = 'rel_status':
	!! $glqs_rs_key is NOT killed below - the Set/Clear acts reference it
	!! directly and QSP resolves act bodies at click time, not at definition
	!! time, same stray-killvar bug class as the navbars $glqs_current.
	$glqs_rs_key = $ARGS[1]
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Relationship Status</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'rel_menu'
	'<center><b>' + $npc_usedname[$glqs_rs_key] + '</b></center>'
	$glqs_rs_current = $npc_rel_type[$glqs_rs_key]
	if $glqs_rs_current = '': $glqs_rs_current = '-'
	'Current status: <b>' + $glqs_rs_current + '</b>'
	killvar '$glqs_rs_current'
	*nl

	if $npc_rel_type[$glqs_rs_key] <> 'dating': act 'Set to Dating': gs 'lover', 'add_dating', $glqs_rs_key & gt 'mod_GLQS_main', 'rel_status', $glqs_rs_key
	if $npc_rel_type[$glqs_rs_key] <> 'boyfriend': act 'Set to Boyfriend': gs 'lover', 'add_boyfriend', $glqs_rs_key & gt 'mod_GLQS_main', 'rel_status', $glqs_rs_key
	if $npc_rel_type[$glqs_rs_key] <> 'girlfriend': act 'Set to Girlfriend': gs 'lover', 'add_girlfriend', $glqs_rs_key & gt 'mod_GLQS_main', 'rel_status', $glqs_rs_key
	if $npc_rel_type[$glqs_rs_key] <> 'fuckbuddy': act 'Set to Fuckbuddy': gs 'lover', 'add_fuckbuddy', $glqs_rs_key & gt 'mod_GLQS_main', 'rel_status', $glqs_rs_key
	if $npc_rel_type[$glqs_rs_key] <> 'sugar_daddy': act 'Set to Sugar Daddy': gs 'lover', 'add_sugar_daddy', $glqs_rs_key & gt 'mod_GLQS_main', 'rel_status', $glqs_rs_key

	!! The base game has remove_boyfriend/girlfriend/fuckbuddy/sugar_daddy but no
	!! remove_dating (lover.qsrc) - the generic remove still correctly
	!! ex-prefixes $npc_rel_type, it just leaves stat[dating_current]
	!! uncorrected, same as vanilla.
	$glqs_rs_type = $npc_rel_type[$glqs_rs_key]
	if $glqs_rs_type = 'boyfriend' or $glqs_rs_type = 'girlfriend' or $glqs_rs_type = 'fuckbuddy' or $glqs_rs_type = 'sugar_daddy':
		$glqs_rs_remove = 'remove_' + $glqs_rs_type
	elseif $glqs_rs_type = 'dating':
		$glqs_rs_remove = 'remove'
	else
		$glqs_rs_remove = ''
	end
	killvar '$glqs_rs_type'
	!! $glqs_rs_remove is read by the act at click time, like $glqs_rs_key.
	if $glqs_rs_remove <> '':
		act 'Clear / End Relationship': gs 'lover', $glqs_rs_remove, $glqs_rs_key & gt 'mod_GLQS_main', 'rel_status', $glqs_rs_key
	end

	act 'Return to Relationships': gt 'mod_GLQS_main', 'rel_menu'
end
