!! CLOTHING ITEM PICKER ROUTES
if $ARGS[0] = 'item_picker':
	!! Image-grid item picker, same pattern as the tattoo/piercing design
	!! pickers - shows every item in a category so a specific one can be
	!! clicked instead of buying the whole category in one shot.
	!! ARGS[1] = item type: clo / shoe / bra / panty / body / coat / purse
	!! ARGS[2] = key - full category name for clo (e.g. allure_swimsuit),
	!!           bare store name for every other type (e.g. bomba)
	!! ARGS[3] = store - bare store name, used only for the Return button
	!! ARGS[4] = label - display name for the category (e.g. Swimsuits)
	!! Copied into globals because the acts and links below read them at
	!! click time, after this call and its $ARGS are gone. total is the games
	!! scratch global, so it is copied straight after clothing_totals sets it.
	$glqs_ptype = $ARGS[1]
	$glqs_pkey = $ARGS[2]
	$glqs_pstore = $ARGS[3]
	$glqs_plabel = $ARGS[4]

	gs 'mod_GLQS_main', 'clothing_totals', $glqs_ptype, $glqs_pkey
	glqs_ptotal = total
	$glqs_picon = $func('$shop_icon_image', $glqs_pkey)

	gs 'mod_GLQS_main', 'screen_head'

	'<center><img src="<<$glqs_picon>>" height="80"><br><b><font color="maroon"><<$glqs_plabel>></font></b></center>'
	'<br><<glqs_ptotal>> items available. Click an image to add it to your wardrobe at full durability.'
	*nl

	$glqs_grid = '<div style="display:flex; flex-wrap:wrap; gap:8px;">'
	glqs_pi = 1
	:glqs_item_picker_loop
	if glqs_pi <= glqs_ptotal:
		if $glqs_ptype = 'clo': $glqs_pimg = $func('$clothing_image', $glqs_pkey, glqs_pi)
		if $glqs_ptype = 'shoe': $glqs_pimg = $func('$shoe_image', $glqs_pkey, glqs_pi)
		if $glqs_ptype = 'bra': $glqs_pimg = $func('$bra_image', $glqs_pkey, glqs_pi)
		if $glqs_ptype = 'panty': $glqs_pimg = $func('$panty_image', $glqs_pkey, glqs_pi)
		if $glqs_ptype = 'body': $glqs_pimg = $func('$bodysuit_image', $glqs_pkey, glqs_pi)
		if $glqs_ptype = 'coat': $glqs_pimg = $func('$coat_image', $glqs_pkey, glqs_pi)
		if $glqs_ptype = 'purse': $glqs_pimg = $func('$purse_image', $glqs_pkey, glqs_pi)

		$glqs_grid += '<div style="flex:0 0 auto;"><a href="exec: gs ''mod_GLQS_main'', ''item_grant'', ''<<$glqs_ptype>>'', ''<<$glqs_pkey>>'', <<glqs_pi>> & gs ''stat'' & gt ''mod_GLQS_main'', ''item_picker'', ''<<$glqs_ptype>>'', ''<<$glqs_pkey>>'', ''<<$glqs_pstore>>'', ''<<$glqs_plabel>>''"><img height="220" src="<<$glqs_pimg>>"></a></div>'

		glqs_pi += 1
		jump 'glqs_item_picker_loop'
	end
	killvar 'glqs_pi'
	$glqs_grid += '</div>'
	$glqs_grid
	killvar '$glqs_grid'
	*nl

	act 'Give All (this category)':
		gs 'mod_GLQS_main', 'fill_by_type', $glqs_ptype, $glqs_pkey
		gt 'mod_GLQS_main', 'item_picker', $glqs_ptype, $glqs_pkey, $glqs_pstore, $glqs_plabel
	end
	act 'Return': gt 'mod_GLQS_main', 'store_detail', $glqs_pstore
	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end
