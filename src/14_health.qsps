!! HEALTH & ENERGY SUBMENU
if $ARGS[0] = 'health_menu':
	menu_off = 0
	usehtml = 1
	$location_type = 'event'
	gs 'stat'
	gs 'themes', 'indoors'
	'<center><b><font color="maroon">Health & Energy</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'health_menu'
	*nl
	$glqs_tbl = ''
	$glqs_tbl += '<table width="80%" cellpadding=4>'
	$glqs_tbl += '<tr><td>Health</td><td><<pcs_health>> / <<healthmax>></td></tr>'
	$glqs_tbl += '<tr><td>Stamina</td><td><<pcs_stam>> / <<stammax>></td></tr>'
	$glqs_tbl += '<tr><td>Willpower</td><td><<pcs_willpwr>> / <<willpowermax>></td></tr>'
	$glqs_tbl += '<tr><td>Mana</td><td><<pcs_mana>></td></tr>'
	$glqs_tbl += '<tr><td>Sleep</td><td><<pcs_sleep>></td></tr>'
	$glqs_tbl += '<tr><td>Mood</td><td><<pcs_mood>></td></tr>'
	$glqs_tbl += '<tr><td>Hunger</td><td><<pcs_energy>></td></tr>'
	$glqs_tbl += '<tr><td>Hydration</td><td><<pcs_hydra>></td></tr>'
	$glqs_tbl += '<tr><td>Faith</td><td><<pcs_faith>></td></tr>'
	$glqs_tbl += '<tr><td>Pregnant</td><td><<iif(preg > 0, ''Yes'', ''No'')>></td></tr>'
	$glqs_tbl += '</table>'
	$glqs_tbl
	*nl

	act 'Full Restore Everything':
		pcs_health = healthmax
		pcs_stam = stammax
		pcs_willpwr = willpowermax
		pcs_mana = (pcs_intel * pcs_magik) + pcs_magik * 100 + pcs_vital * 10 + rikudo
		pcs_sleep = 100
		pcs_mood = 100
		pcs_energy = 100
		pcs_hydra = 200
		pcs_faith = 100
		vgape = 0
		agape = 0
		nippain = 0
		gs 'stat'
		gt 'mod_GLQS_main', 'health_menu'
	end

	if preg = 0:
		act 'Force Pregnancy':
			!! Reuses the base games own cheat handler rather than
			!! reimplementing it - it spawns a throwaway donor NPC internally
			!! (fertility.qsrc requires a real, known NPC ID; there is no
			!! NPC-less path), so no NPC picker is needed here.
			gs 'cheatmenu_din', 'force_preg'
			gs 'stat'
			gt 'mod_GLQS_main', 'health_menu'
		end
	else
		act 'Remove Pregnancy':
			gs 'cheatmenu_din', 'remove_preg'
			gs 'stat'
			gt 'mod_GLQS_main', 'health_menu'
		end
	end

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end
