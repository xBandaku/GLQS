!! CONSUMABLES SUBMENU
if $ARGS[0] = 'consumables_menu':
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Consumables</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'consumables_menu'
	*nl
	gs 'mod_GLQS_main', 'consumables_data'
	$glqs_tbl = '<table width="80%" cellpadding=4>'
	glqs_con_i = 0
	$glqs_con_last_category = ''
:glqs_consumables_quantity_loop
	if glqs_con_i >= glqs_con_n: jump 'glqs_consumables_quantity_done'
	if $glqs_con_kind[glqs_con_i] = 'quantity':
		if $glqs_con_category[glqs_con_i] <> $glqs_con_last_category:
			$glqs_tbl += '<tr><td><b>' + $glqs_con_category[glqs_con_i] + '</b></td><td></td></tr>'
			$glqs_con_last_category = $glqs_con_category[glqs_con_i]
		end
		$glqs_tbl += '<tr><td>' + $glqs_con_label[glqs_con_i] + '</td><td>' + mc_inventory[$glqs_con_key[glqs_con_i]] + '</td></tr>'
	end
	glqs_con_i += 1
	jump 'glqs_consumables_quantity_loop'
:glqs_consumables_quantity_done
	$glqs_tbl += '</table>'
	$glqs_tbl
	*nl

	act 'Set All to 10,000':
		gs 'mod_GLQS_main', 'consumables', 10000
		gt 'mod_GLQS_main', 'consumables_menu'
	end

	act 'Set All to 1,000':
		gs 'mod_GLQS_main', 'consumables', 1000
		gt 'mod_GLQS_main', 'consumables_menu'
	end

	act 'Set All to 100':
		gs 'mod_GLQS_main', 'consumables', 100
		gt 'mod_GLQS_main', 'consumables_menu'
	end

	'<b>Individual toggles</b> (the base game caps these at 1 regardless of quantity, so Set All above does not apply to them - each toggles independently):'
	*nl
	$glqs_tbl2 = '<table width="80%" cellpadding=4>'
	glqs_con_i = 0
	$glqs_con_last_category = ''
:glqs_consumables_toggle_loop
	if glqs_con_i >= glqs_con_n: jump 'glqs_consumables_toggle_done'
	if $glqs_con_kind[glqs_con_i] = 'toggle':
		if $glqs_con_category[glqs_con_i] <> $glqs_con_last_category:
			$glqs_tbl2 += '<tr><td><b>' + $glqs_con_category[glqs_con_i] + '</b></td><td></td></tr>'
			$glqs_con_last_category = $glqs_con_category[glqs_con_i]
		end
		$glqs_tbl2 += '<tr><td>' + $glqs_con_label[glqs_con_i] + '</td><td><a href="exec: mc_inventory['''' + $glqs_con_key[glqs_con_i] + ''''] = iif(mc_inventory['''' + $glqs_con_key[glqs_con_i] + ''''] > 0, 0, 1) & gt ''mod_GLQS_main'', ''consumables_menu''">' + iif(mc_inventory[$glqs_con_key[glqs_con_i]] > 0, 'Owned', 'Not owned') + '</a></td></tr>'
	end
	glqs_con_i += 1
	jump 'glqs_consumables_toggle_loop'
:glqs_consumables_toggle_done
	$glqs_tbl2 += '</table>'
	$glqs_tbl2
	*nl

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end
