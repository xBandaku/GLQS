	$glqs_st[glqs_st_n] = 'Artistic Skills|lvl|perform|Performance' & glqs_st_n += 1
	$glqs_st[glqs_st_n] = 'Artistic Skills|lvl|musicprod|Music Prod' & glqs_st_n += 1
	$glqs_st[glqs_st_n] = 'Work Skills|lvl|compskl|Computer Skill' & glqs_st_n += 1
	$glqs_st[glqs_st_n] = 'Work Skills|lvl|comphckng|Hacking' & glqs_st_n += 1
	$glqs_st[glqs_st_n] = 'Work Skills|lvl|hndiwrk|Handiwork' & glqs_st_n += 1
	$glqs_st[glqs_st_n] = 'Work Skills|lvl|sewng|Tailoring' & glqs_st_n += 1
	$glqs_st[glqs_st_n] = 'Work Skills|lvl|servng|Serving' & glqs_st_n += 1
	$glqs_st[glqs_st_n] = 'Work Skills|lvl|medcn|Medicine' & glqs_st_n += 1
	$glqs_st[glqs_st_n] = 'Work Skills|lvl|cleaning|Cleaning' & glqs_st_n += 1
	$glqs_st[glqs_st_n] = 'Work Skills|lvl|mdlng|Modelling' & glqs_st_n += 1
	glqs_st_total = glqs_st_n
	killvar 'glqs_st_n'
end
