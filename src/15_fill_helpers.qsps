!! CLOTHING TYPE DISPATCH AND FILL HELPERS
!! Each helper mirrors the full array set the games own add_item handlers do
!! (clothing.qsrc / shoes.qsrc / bras.qsrc / panties.qsrc /
!! underwear_bodysuits.qsrc / coats.qsrc / purses.qsrc), including zeroing the
!! alteration and dirt state arrays - without those, re-granting an item the
!! player already owned kept its old dirt/alteration instead of arriving
!! factory-fresh like a real purchase.
if $ARGS[0] = 'clothing_totals':
	$glqs_type = $ARGS[1]
	$glqs_key = $ARGS[2]
	if $glqs_type = 'clo': gs 'clothing', 'totals', $glqs_key
	if $glqs_type = 'shoe': gs 'shoes', 'totals', $glqs_key + '_shoe'
	if $glqs_type = 'bra': gs 'bras', 'totals', $glqs_key + '_bras'
	if $glqs_type = 'panty': gs 'panties', 'totals', $glqs_key + '_panties'
	if $glqs_type = 'body': gs 'underwear_bodysuits', 'totals', $glqs_key + '_bodysuits'
	if $glqs_type = 'coat': gs 'coats', 'totals', $glqs_key + '_coats'
	if $glqs_type = 'purse': gs 'purses', 'totals', $glqs_key + '_purses'
	killvar '$glqs_type' & killvar '$glqs_key'
end

if $ARGS[0] = 'fill_by_type':
	$glqs_fill_type = $ARGS[1]
	$glqs_fill_key = $ARGS[2]
	if $glqs_fill_type = 'clo': gs 'mod_GLQS_main', 'fill_clo', $glqs_fill_key
	if $glqs_fill_type = 'shoe': gs 'mod_GLQS_main', 'fill_shoe', $glqs_fill_key
	if $glqs_fill_type = 'bra': gs 'mod_GLQS_main', 'fill_bra', $glqs_fill_key
	if $glqs_fill_type = 'panty': gs 'mod_GLQS_main', 'fill_panty', $glqs_fill_key
	if $glqs_fill_type = 'body': gs 'mod_GLQS_main', 'fill_body', $glqs_fill_key
	if $glqs_fill_type = 'coat': gs 'mod_GLQS_main', 'fill_coat', $glqs_fill_key
	if $glqs_fill_type = 'purse': gs 'mod_GLQS_main', 'fill_purse', $glqs_fill_key
	killvar '$glqs_fill_type' & killvar '$glqs_fill_key'
end

if $ARGS[0] = 'fill_clo':
	$glqs_fill_key = $ARGS[1]
	gs 'mod_GLQS_main', 'clothing_totals', 'clo', $glqs_fill_key
	glqs_fill_total = total
	glqs_i = 1
	:glqs_clo_loop
	if glqs_i <= glqs_fill_total:
		gs 'mod_GLQS_main', 'item_grant', 'clo', $glqs_fill_key, glqs_i
		glqs_i += 1
		jump 'glqs_clo_loop'
	end
	killvar 'glqs_i' & killvar 'glqs_fill_total' & killvar '$glqs_fill_key'
end
