!! CLOTHING TYPE DISPATCH AND FILL HELPERS
!! clothing_totals maps a GLQS type key onto the games own per-category totals
!! handler; fill_by_type then grants every index in that category through
!! item_grant (14_fill_data.qsps), which is what mirrors the full array set the
!! games own add_item handlers write (clothing.qsrc / shoes.qsrc / bras.qsrc /
!! panties.qsrc / underwear_bodysuits.qsrc / coats.qsrc / purses.qsrc),
!! including zeroing the alteration and dirt state arrays - without those,
!! re-granting an item the player already owned kept its old dirt/alteration
!! instead of arriving factory-fresh like a real purchase.
if $ARGS[0] = 'clothing_totals':
	$glqs_type = $ARGS[1]
	$glqs_key = $ARGS[2]
	if $glqs_type = 'clo': gs 'clothing', 'totals', $glqs_key
	if $glqs_type = 'shoe': gs 'shoes', 'totals', $glqs_key + '_shoe'
	if $glqs_type = 'bra': gs 'bras', 'totals', $glqs_key + '_bras'
	if $glqs_type = 'panty': gs 'panties', 'totals', $glqs_key + '_panties'
	if $glqs_type = 'body': gs 'underwear_bodysuits', 'totals', $glqs_key + '_bodysuits'
	if $glqs_type = 'coat': gs 'coats', 'totals', $glqs_key + '_coats'
	if $glqs_type = 'purse': gs 'purses', 'totals', $glqs_key + '_purses'
	killvar '$glqs_type' & killvar '$glqs_key'
end

if $ARGS[0] = 'fill_by_type':
	!! Captured before the nested gs calls below - $ARGS is one shared array in
	!! QSP, not scoped per gosub, so clothing_totals would clobber them first.
	$glqs_fill_type = $ARGS[1]
	$glqs_fill_key = $ARGS[2]
	gs 'mod_GLQS_main', 'clothing_totals', $glqs_fill_type, $glqs_fill_key
	glqs_fill_total = total
	glqs_i = 1
	:glqs_fill_loop
	if glqs_i <= glqs_fill_total:
		gs 'mod_GLQS_main', 'item_grant', $glqs_fill_type, $glqs_fill_key, glqs_i
		glqs_i += 1
		jump 'glqs_fill_loop'
	end
	killvar 'glqs_i' & killvar 'glqs_fill_total' & killvar '$glqs_fill_type' & killvar '$glqs_fill_key'
end
