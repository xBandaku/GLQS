!! CLOTHING GRANT ROUTES
!! clothing_totals maps a GLQS type key onto the games own per-category totals
!! handler. item_grant adds one item and writes the full array set the games
!! own add_item handlers write (clothing.qsrc / shoes.qsrc / bras.qsrc /
!! panties.qsrc / underwear_bodysuits.qsrc / coats.qsrc / purses.qsrc),
!! including zeroing the alteration and dirt state arrays - without those,
!! re-granting an item the player already owned kept its old dirt/alteration
!! instead of arriving factory-fresh like a real purchase. fill_by_type grants
!! every item in one category through item_grant.
if $ARGS[0] = 'clothing_totals':
	$glqs_ct_type = $ARGS[1]
	$glqs_ct_key = $ARGS[2]
	if $glqs_ct_type = 'clo': gs 'clothing', 'totals', $glqs_ct_key
	if $glqs_ct_type = 'shoe': gs 'shoes', 'totals', $glqs_ct_key + '_shoe'
	if $glqs_ct_type = 'bra': gs 'bras', 'totals', $glqs_ct_key + '_bras'
	if $glqs_ct_type = 'panty': gs 'panties', 'totals', $glqs_ct_key + '_panties'
	if $glqs_ct_type = 'body': gs 'underwear_bodysuits', 'totals', $glqs_ct_key + '_bodysuits'
	if $glqs_ct_type = 'coat': gs 'coats', 'totals', $glqs_ct_key + '_coats'
	if $glqs_ct_type = 'purse': gs 'purses', 'totals', $glqs_ct_key + '_purses'
	killvar '$glqs_ct_type'
	killvar '$glqs_ct_key'
end

if $ARGS[0] = 'fill_by_type':
	!! Own glqs_fill_ prefix so the nested clothing_totals and item_grant calls,
	!! which set and kill their own globals, cannot overwrite these mid-loop.
	$glqs_fill_type = $ARGS[1]
	$glqs_fill_key = $ARGS[2]
	gs 'mod_GLQS_main', 'clothing_totals', $glqs_fill_type, $glqs_fill_key
	glqs_fill_total = total
	glqs_fill_i = 1
	:glqs_fill_loop
	if glqs_fill_i <= glqs_fill_total:
		gs 'mod_GLQS_main', 'item_grant', $glqs_fill_type, $glqs_fill_key, glqs_fill_i
		glqs_fill_i += 1
		jump 'glqs_fill_loop'
	end
	killvar 'glqs_fill_i'
	killvar 'glqs_fill_total'
	killvar '$glqs_fill_type'
	killvar '$glqs_fill_key'
end

if $ARGS[0] = 'item_grant':
	$glqs_ip_type = $ARGS[1]
	$glqs_ip_key = $ARGS[2]
	glqs_ip_idx = ARGS[3]

	if $glqs_ip_type = 'clo':
		dyneval('<<$glqs_ip_key>>[glqs_ip_idx] = 1')
		gs 'clothing_attributes', $glqs_ip_key, glqs_ip_idx
		dyneval('<<$glqs_ip_key>>_h[glqs_ip_idx] = CloMaxStrength')
		dyneval('<<$glqs_ip_key>>_b[glqs_ip_idx] = pcs_hips')
		dyneval('<<$glqs_ip_key>>_s[glqs_ip_idx] = 0')
		dyneval('<<$glqs_ip_key>>_dirt[glqs_ip_idx] = 0')
	end
	if $glqs_ip_type = 'shoe':
		dyneval('<<$glqs_ip_key>>_shoe[glqs_ip_idx] = 1')
		gs 'shoe_attributes', $glqs_ip_key, glqs_ip_idx
		dyneval('<<$glqs_ip_key>>_shoe_h[glqs_ip_idx] = ShoMaxStrength')
		dyneval('<<$glqs_ip_key>>_shoe_s[glqs_ip_idx] = 0')
	end
	if $glqs_ip_type = 'bra':
		dyneval('<<$glqs_ip_key>>_bras[glqs_ip_idx] = 1')
		gs 'underwear_attributes', $glqs_ip_key + '_bras', glqs_ip_idx
		dyneval('<<$glqs_ip_key>>_bras_h[glqs_ip_idx] = BraMaxStrength')
		dyneval('<<$glqs_ip_key>>_brasS[glqs_ip_idx] = 0')
		dyneval('<<$glqs_ip_key>>_bras_dirt[glqs_ip_idx] = 0')
	end
	if $glqs_ip_type = 'panty':
		dyneval('<<$glqs_ip_key>>_panties[glqs_ip_idx] = 1')
		gs 'underwear_attributes', $glqs_ip_key + '_panties', glqs_ip_idx
		dyneval('<<$glqs_ip_key>>_panties_h[glqs_ip_idx] = PanMaxStrength')
		dyneval('<<$glqs_ip_key>>_pantiesS[glqs_ip_idx] = 0')
		dyneval('<<$glqs_ip_key>>_panties_dirt[glqs_ip_idx] = 0')
	end
	if $glqs_ip_type = 'body':
		dyneval('<<$glqs_ip_key>>_bodysuits[glqs_ip_idx] = 1')
		gs 'underwear_attributes', $glqs_ip_key + '_bodysuits', glqs_ip_idx
		dyneval('<<$glqs_ip_key>>_bodysuits_h[glqs_ip_idx] = BraMaxStrength')
		dyneval('<<$glqs_ip_key>>_bodysuits_s[glqs_ip_idx] = 0')
		dyneval('<<$glqs_ip_key>>_bodysuits_dirt[glqs_ip_idx] = 0')
	end
	if $glqs_ip_type = 'coat':
		dyneval('<<$glqs_ip_key>>_coats[glqs_ip_idx] = 1')
		gs 'coat_attributes', $glqs_ip_key, glqs_ip_idx
		dyneval('<<$glqs_ip_key>>_coats_h[glqs_ip_idx] = CoatMaxStrength')
		dyneval('<<$glqs_ip_key>>_coats_s[glqs_ip_idx] = 0')
		dyneval('<<$glqs_ip_key>>_coats_w[glqs_ip_idx] = 0')
	end
	if $glqs_ip_type = 'purse':
		gs 'purse_attributes', $glqs_ip_key, glqs_ip_idx
		if PursePrice <> 0:
			dyneval('<<$glqs_ip_key>>_purses[glqs_ip_idx] = 1')
		end
	end
	killvar '$glqs_ip_type'
	killvar '$glqs_ip_key'
	killvar 'glqs_ip_idx'
end
