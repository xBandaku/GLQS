!! CLOTHING DATA
if $ARGS[0] = 'clothing_cat_build':
	!! One flat array of every store category the game actually sells,
	!! shared by store_buy (per-store buyout, or every store when the clothing
	!! menu Give Everything passes an empty store) and the build-time picker
	!! expansion, so the lists can never drift apart. Entry format:
	!! store|type|key|label. type is one of clo/shoe/bra/panty/body/coat/purse,
	!! the types clothing_totals and item_grant in 05_clothing_grant.qsps accept.
	killvar '$glqs_cc'
	$glqs_cc[] = 'allure|clo|allure_swimsuit|Swimsuits'
