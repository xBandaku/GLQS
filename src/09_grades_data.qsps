!! SCHOOL GRADE METADATA
!! code|label. The game stores each grade in class[school_<code>_grade].
if $ARGS[0] = 'grades_data':
	killvar '$glqs_grade'
	$glqs_grade[] = 'math|Math'
	$glqs_grade[] = 'rus|Russian'
	$glqs_grade[] = 'lit|Literature'
	$glqs_grade[] = 'art|Art'
	$glqs_grade[] = 'bio|Biology'
	$glqs_grade[] = 'eng|English'
	$glqs_grade[] = 'geo|Geography'
	$glqs_grade[] = 'sci|Science'
	$glqs_grade[] = 'his|History'
	$glqs_grade[] = 'shop|Shop'
	$glqs_grade[] = 'comp|Computer'
	$glqs_grade[] = 'mus|Music'
	$glqs_grade[] = 'pe|P.E.'
end
