!! JOBS & CAREER SUBMENU
!! Job list is one flat pipe-delimited array (id|title), the same pattern as
!! the NPC roster in 12_relationships.qsps - there is no master enumeration
!! array in the real game (each job is only a lazily-defined gosub branch in
!! jobs_list.qsrc), so this is a hand-maintained copy of every job id/title
!! pair currently defined there.
if $ARGS[0] = 'job_list_build':
	glqs_jb_n = 0
	$glqs_jb[glqs_jb_n] = 'city_office_secretary|Office Secretary' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_cafe_waitress|Cafe Waitress' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_hospital_nurse|Hospital Nurse' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_diner_dishwasher|Diner Cleaning Gig' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_diner_floor_washer|Diner Floor Washing' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_office_cleaner|Office Cleaning Gig' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_office_toilet_cleaner|Toilet Cleaning Gig' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_diner_secretary|Diner Secretary' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_strip_bargirl|Strip Club Bargirl' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_strip_stripper|Stripper' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_pussycats_clerk|Shop Clerk' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_pornstudio_actress|Porn Actress' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_pornstudio_delivery|Delivery Courier' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_aphrodite_model|Model' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'pav_hotel_maid|Hotel Cleaning Gig' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'pav_clinic_cleaner|Clinic Cleaning Gig' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'pav_factory|Factory Worker' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'pav_mailgirl|Mail Delivery Gig' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'pav_tour_guide|Tour Guide Gig' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'pav_barbershop_cleaner|Barbershop Cleaning Gig' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'pav_train_cleaner|Train Station Cleaning Gig' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'pav_pool_lifeguard|Lifeguard' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'pav_voc_school_teacher|Teacher' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_market_saleswoman|Market Saleswoman' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'highway_brothel_prostitute|Highway Brothel Prostitute' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'nich_maid|Live-in Maid' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'city_salon_masseuse|Masseuse' & glqs_jb_n += 1
	$glqs_jb[glqs_jb_n] = 'pav_leonid_slave|Slave' & glqs_jb_n += 1
	glqs_jb_total = glqs_jb_n
	killvar 'glqs_jb_n'
end


if $ARGS[0] = 'jobs_menu':
	menu_off = 0
	usehtml = 1
	$location_type = 'event'
	gs 'stat'
	gs 'themes', 'indoors'
	'<center><b><font color="maroon">Jobs & Career</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'jobs_menu'
	*nl

	gs 'mod_GLQS_main', 'job_list_build'

	glqs_jm_held = arrsize('$job_list')
	if glqs_jm_held > 0:
		'<b>Current jobs</b>'
		$glqs_tbl = '<table width="80%" cellpadding=3>'
		$glqs_tbl += '<tr><th align="left">Job</th><th align="left">Rank</th><th align="left">Pay Rate</th><th align="left"></th></tr>'
		glqs_jm_i = 0
		:glqs_jobs_held_loop
		if glqs_jm_i < glqs_jm_held:
			$glqs_jm_id = $job_list[glqs_jm_i]
			$glqs_jm_title = $glqs_jm_id
			glqs_jm_j = 0
			:glqs_jobs_held_title_loop
			if glqs_jm_j < glqs_jb_total:
				$glqs_jm_row = $glqs_jb[glqs_jm_j]
				glqs_jm_p1 = instr($glqs_jm_row, '|')
				if $mid($glqs_jm_row, 1, glqs_jm_p1 - 1) = $glqs_jm_id:
					$glqs_jm_title = $mid($glqs_jm_row, glqs_jm_p1 + 1)
				end
				glqs_jm_j += 1
				jump 'glqs_jobs_held_title_loop'
			end
			$glqs_tbl += '<tr><td>' + $glqs_jm_title + '</td><td>' + job_rank[$glqs_jm_id] + '</td><td>' + job_pay_rate[$glqs_jm_id] + '</td><td>'
			$glqs_tbl += '<a href="exec: job_rank[''' + $glqs_jm_id + '''] = 5 & gt ''mod_GLQS_main'', ''jobs_menu''">Max Rank</a> '
			$glqs_tbl += '<a href="exec: job_pay_rate[''' + $glqs_jm_id + '''] = job_pay_rate[''' + $glqs_jm_id + '''] * 10 & gt ''mod_GLQS_main'', ''jobs_menu''">Boost Pay</a> '
			$glqs_tbl += '<a href="exec: job_missed_total[''' + $glqs_jm_id + '''] = 0 & job_booking_debt[''' + $glqs_jm_id + '''] = 0 & job_docked_pay[''' + $glqs_jm_id + '''] = 0 & gt ''mod_GLQS_main'', ''jobs_menu''">Clear Penalties</a>'
			$glqs_tbl += '</td></tr>'
			glqs_jm_i += 1
			jump 'glqs_jobs_held_loop'
		end
		$glqs_tbl += '</table>'
		$glqs_tbl
		*nl
	end

	'<b>Available jobs</b> (Instant-Hire skips the interview/hiring quest entirely, same as the games own cheatVars[show_hidden_jobs]/cheatVars[work] debug hooks):'
	$glqs_tbl2 = '<table width="80%" cellpadding=3>'
	glqs_jm_i = 0
	:glqs_jobs_all_loop
	if glqs_jm_i < glqs_jb_total:
		$glqs_jm_row = $glqs_jb[glqs_jm_i]
		glqs_jm_p1 = instr($glqs_jm_row, '|')
		$glqs_jm_id = $mid($glqs_jm_row, 1, glqs_jm_p1 - 1)
		$glqs_jm_title = $mid($glqs_jm_row, glqs_jm_p1 + 1)
		if $job_status[$glqs_jm_id] <> 'employed':
			$glqs_tbl2 += '<tr><td>' + $glqs_jm_title + '</td><td><a href="exec: gs ''jobs'', ''set_employed'', ''' + $glqs_jm_id + ''' & gt ''mod_GLQS_main'', ''jobs_menu''">Instant-Hire</a></td></tr>'
		end
		glqs_jm_i += 1
		jump 'glqs_jobs_all_loop'
	end
	$glqs_tbl2 += '</table>'
	$glqs_tbl2
	*nl

	killvar 'glqs_jm_held' & killvar 'glqs_jm_i' & killvar 'glqs_jm_j' & killvar 'glqs_jm_p1'
	killvar '$glqs_jm_id' & killvar '$glqs_jm_title' & killvar '$glqs_jm_row'
	killvar '$glqs_jb' & killvar 'glqs_jb_total'

	act 'Ignore Job Schedule Conflicts':
		!! Reuses the games own existing debug hook (jobs.qsrc
		!! check_employment_possible) rather than reimplementing it.
		cheatVars['work'] = 1
		gt 'mod_GLQS_main', 'jobs_menu'
	end

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end
