!! CLOTHING STORE ROUTES
if $ARGS[0] = 'store_buy':
	!! Buys out every category a given store/brand carries, matching the
	!! games actual catalog (not every store sells every category).
	!! An empty ARGS[1] means every store - the clothing_menu Give Everything
	!! action used to run its own copy of this loop without the store filter.
	!! Driven by the shared clothing_cat_build table below so this can
	!! never drift from store_detail.
	$glqs_sb_store = $ARGS[1]
	gs 'mod_GLQS_main', 'clothing_cat_build'
	glqs_sb_i = 0
	glqs_sb_total = arrsize('$glqs_cc')
	:glqs_store_buy_loop
	if glqs_sb_i < glqs_sb_total:
		!! Row format is store|type|key|label.
		gs 'mod_GLQS_main', 'split_row', $glqs_cc[glqs_sb_i]
		if $glqs_sb_store = '' or $glqs_field[0] = $glqs_sb_store:
			gs 'mod_GLQS_main', 'fill_by_type', $glqs_field[1], $glqs_field[2]
		end
		glqs_sb_i += 1
		jump 'glqs_store_buy_loop'
	end
	killvar 'glqs_sb_i'
	killvar 'glqs_sb_total'
	killvar '$glqs_sb_store'
	killvar '$glqs_field'
	killvar '$glqs_cc'
end



if $ARGS[0] = 'store_detail':
	!! Per-store category breakdown. Mirrors the store_buy dispatcher above,
	!! but exposes each category the store carries as its own button instead
	!! of buying everything in one shot.
	!! Copied into a global because the Buy All act below reads it at click
	!! time, after this call and its $ARGS are gone.
	$glqs_store = $ARGS[1]
	gs 'mod_GLQS_main', 'screen_head'

	!! GLQS_CLOTHING_LABELS_BEGIN
	!! GLQS_CLOTHING_LABELS_END
	$glqs_sicon = $func('$shop_icon_image', $glqs_store)

	'<center><img src="<<$glqs_sicon>>" height="80"><br><b><font color="maroon"><<$glqs_label>></font></b></center>'
	*nl
	'Pick a category to browse it item-by-item, or grab everything this store carries.'
	*nl
	killvar '$glqs_sicon'
	killvar '$glqs_label'

	!! GLQS_CLOTHING_ACTIONS_BEGIN
	!! GLQS_CLOTHING_ACTIONS_END
	*nl
	act 'Buy All (this store)': gs 'mod_GLQS_main', 'store_buy', $glqs_store & gt 'mod_GLQS_main', 'store_detail', $glqs_store
	act 'Return': gt 'mod_GLQS_main', 'store_menu'
	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end
