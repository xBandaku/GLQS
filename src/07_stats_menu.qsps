!! SKILLS & ATTRIBUTES SUBMENU
if $ARGS[0] = 'stats_menu':
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Skills & Attributes</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'stats_menu'
	*nl
	$glqs_tbl = ''
	$glqs_tbl += '<table width="80%" cellpadding=4>'
	gs 'mod_GLQS_main', 'stats_data'
	$glqs_sm_prevgrp = ''
	glqs_sm_i = 0
	:glqs_stats_tbl_loop
	if glqs_sm_i < glqs_st_total:
		$glqs_sm_row = $glqs_st[glqs_sm_i]
		glqs_sm_p1 = instr($glqs_sm_row, '|')
		$glqs_sm_grp = $mid($glqs_sm_row, 1, glqs_sm_p1 - 1)
		$glqs_sm_rest = $mid($glqs_sm_row, glqs_sm_p1 + 1)
		glqs_sm_p2 = instr($glqs_sm_rest, '|')
		$glqs_sm_kind = $mid($glqs_sm_rest, 1, glqs_sm_p2 - 1)
		$glqs_sm_rest2 = $mid($glqs_sm_rest, glqs_sm_p2 + 1)
		glqs_sm_p3 = instr($glqs_sm_rest2, '|')
		$glqs_sm_key = $mid($glqs_sm_rest2, 1, glqs_sm_p3 - 1)
		$glqs_sm_label = $mid($glqs_sm_rest2, glqs_sm_p3 + 1)
		if $glqs_sm_grp <> $glqs_sm_prevgrp:
			$glqs_tbl += '<tr><td><b>' + $glqs_sm_grp + '</b></td><td></td></tr>'
			$glqs_sm_prevgrp = $glqs_sm_grp
		end
		if $glqs_sm_kind = 'lvl':
			glqs_sm_val = dyneval('result = <<$glqs_sm_key>>_lvl')
		else
			glqs_sm_val = dyneval('result = <<$glqs_sm_key>>')
		end
		$glqs_tbl += '<tr><td>' + $glqs_sm_label + '</td><td><<glqs_sm_val>></td></tr>'
		glqs_sm_i += 1
		jump 'glqs_stats_tbl_loop'
	end
	$glqs_tbl += '</table>'
	$glqs_tbl
	*nl
	killvar 'glqs_sm_i' & killvar 'glqs_sm_p1' & killvar 'glqs_sm_p2' & killvar 'glqs_sm_p3'
	killvar '$glqs_sm_row' & killvar '$glqs_sm_rest' & killvar '$glqs_sm_rest2'
	killvar '$glqs_sm_grp' & killvar '$glqs_sm_prevgrp' & killvar '$glqs_sm_kind'
	killvar '$glqs_sm_key' & killvar '$glqs_sm_label' & killvar 'glqs_sm_val'
	killvar '$glqs_st' & killvar 'glqs_st_total'

	act 'Max All Skills & Attributes':
		gs 'mod_GLQS_main', 'stats'
		gt 'mod_GLQS_main', 'stats_menu'
	end

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end
