!! BODY MODS + TATTOO/PIERCING PICKERS
if $ARGS[0] = 'bodymod_menu':
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Body Mods</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'bodymod_menu'
	'<br>Electrolysis is free through this menu (normally 80,000 RUB at the clinic).'
	*nl
	gs 'mod_GLQS_main', 'bodymod_zones'
	glqs_bz_tattoos = 0
	glqs_bz_piercings = 0
	glqs_bz_i = 0
	:glqs_bodymod_count_loop
	if glqs_bz_i < arrsize('$glqs_bz'):
		if instr($glqs_bz[glqs_bz_i], 'tattoo|') = 1: glqs_bz_tattoos += 1
		if instr($glqs_bz[glqs_bz_i], 'piercing|') = 1: glqs_bz_piercings += 1
		glqs_bz_i += 1
		jump 'glqs_bodymod_count_loop'
	end
	killvar 'glqs_bz_i'
	killvar '$glqs_bz'
	$glqs_tbl = ''
	$glqs_tbl += '<table width="80%" cellpadding=4>'
	$glqs_tbl += '<tr><td>Leg hair</td><td><<$iif(pcs_leghair = 0, ''Removed'', ''Present'')>></td></tr>'
	$glqs_tbl += '<tr><td>Pubic hair</td><td><<$iif(pcs_pubes = 0, ''Removed'', ''Present'')>></td></tr>'
	$glqs_tbl += '<tr><td>Tattoos</td><td><<pcs_tattoos[''total'']>> / <<glqs_bz_tattoos>> zones</td></tr>'
	$glqs_tbl += '<tr><td>Piercings</td><td><<pcs_piercings[''total'']>> / <<glqs_bz_piercings>> slots</td></tr>'
	$glqs_tbl += '<tr><td>Attractiveness</td><td><<pcs_apprnc>> (<<pcs_hotcat>>/10)</td></tr>'
	$glqs_tbl += '</table>'
	$glqs_tbl
	killvar '$glqs_tbl'
	*nl
	killvar 'glqs_bz_tattoos'
	killvar 'glqs_bz_piercings'

	act 'Free Electrolysis (permanent hair removal)':
		pcs_leghair = 0
		pcs_pubes = 0
		lashair = 1
		gs 'stat'
		gt 'mod_GLQS_main', 'bodymod_menu'
	end

	act 'Max Attractiveness (resets nightly, click again to reapply)':
		gs 'mod_GLQS_main', 'max_attractiveness'
		gt 'mod_GLQS_main', 'bodymod_menu'
	end

	act 'Choose a Tattoo': gt 'mod_GLQS_main', 'bodymod_zone_menu', 'tattoo'

	act 'Choose a Piercing': gt 'mod_GLQS_main', 'bodymod_zone_menu', 'piercing'

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end


if $ARGS[0] = 'max_attractiveness':
	!! pcs_apprnc is not a settable stat - AppearanceSystem.qsrc recomputes it
	!! from pcs_apprncbase plus live clothing/accessories/grooming bonuses and
	!! penalties every time gs stat runs (gs stat -> gs body, Update_Appearance
	!! -> gs AppearanceSystem), and CalcAppearance clamps that whole sum to
	!! 0-200 before adding a separate supernatural bonus on top. Rather than
	!! reverse engineering and maxing every underlying clothing-quality and
	!! body-composition input individually (CalcClothingBonus and
	!! CalcAccessoriesBonus in outfit.qsrc, and the BMI-dependent logic inside
	!! CalcBodyShapeBonus), setting pcs_apprncbase itself to a large value
	!! guarantees the 0-200 clamp always saturates at the max regardless of
	!! what is worn or
	!! current body composition - confirmed against both reference/0.9.8.3 and
	!! reference/nightly, which use an identical clamp formula (only the
	!! separate supernatural-bonus term differs between the two, which this
	!! does not touch, so any archetype/succubus bonus a save already has
	!! still applies normally on top of the guaranteed 200).
	!! pcs_apprncbase is only recalculated by an explicit
	!! gs AppearanceSystem, UpdateBaseAppearance call (daily at midnight, or a
	!! few specific cheats/spells) - never by gs stat - so this override
	!! persists across menus until the next in-game day, same as School
	!! Grades resetting weekly.
	pcs_apprncbase = 1000
	gs 'stat'
end


!! ===== TATTOO AND PIERCING ZONES =====

if $ARGS[0] = 'bodymod_zones':
	!! kind|zone|label for every tattoo zone and piercing slot the games
	!! tattoo_management / piercing_management locations accept.
	killvar '$glqs_bz'
	$glqs_bz[] = 'tattoo|ankle|Ankle'
	$glqs_bz[] = 'tattoo|arm|Arm'
	$glqs_bz[] = 'tattoo|ass|Ass'
	$glqs_bz[] = 'tattoo|back|Back'
	$glqs_bz[] = 'tattoo|belly|Belly'
	$glqs_bz[] = 'tattoo|breast|Breast'
	$glqs_bz[] = 'tattoo|chest|Chest'
	$glqs_bz[] = 'tattoo|face|Face'
	$glqs_bz[] = 'tattoo|hand|Hand'
	$glqs_bz[] = 'tattoo|leg|Leg'
	$glqs_bz[] = 'tattoo|lip|Lip'
	$glqs_bz[] = 'tattoo|neck|Neck'
	$glqs_bz[] = 'tattoo|pussy|Pussy'
	$glqs_bz[] = 'tattoo|shoulder|Shoulder'
	$glqs_bz[] = 'tattoo|side|Side'
	$glqs_bz[] = 'tattoo|tramp|Tramp Stamp'
	$glqs_bz[] = 'tattoo|under|Underboob'
	$glqs_bz[] = 'tattoo|wrist|Wrist'
	$glqs_bz[] = 'piercing|ears|Ears'
	$glqs_bz[] = 'piercing|nose|Nose'
	$glqs_bz[] = 'piercing|brow|Eyebrow'
	$glqs_bz[] = 'piercing|lip|Lip'
	$glqs_bz[] = 'piercing|tongue|Tongue'
	$glqs_bz[] = 'piercing|navel|Navel'
	$glqs_bz[] = 'piercing|nipples|Nipples'
	$glqs_bz[] = 'piercing|pussy|Pussy'
end


if $ARGS[0] = 'bodymod_zone_menu':
	!! ARGS[1] = tattoo or piercing. Zones are links rather than acts: a link
	!! built in a loop carries its zone literally, while an act body would
	!! read the loop variable at click time.
	$glqs_bz_kind = $ARGS[1]
	gs 'mod_GLQS_main', 'screen_head'
	if $glqs_bz_kind = 'tattoo':
		'<center><b><font color="maroon">Choose a Tattoo Zone</font></b></center>'
		'<br>Pick a body zone, then pick a design. The current design number is shown in brackets.'
	else
		'<center><b><font color="maroon">Choose a Piercing Slot</font></b></center>'
		'<br>Pick a slot, then pick jewelry. The current design number is shown in brackets.'
	end
	*nl
	gs 'mod_GLQS_main', 'bodymod_zones'
	$glqs_tbl = '<table cellpadding=3>'
	glqs_bz_i = 0
	:glqs_bodymod_zone_loop
	if glqs_bz_i < arrsize('$glqs_bz'):
		!! Row format is kind|zone|label.
		gs 'mod_GLQS_main', 'split_row', $glqs_bz[glqs_bz_i]
		if $glqs_field[0] = $glqs_bz_kind:
			if $glqs_bz_kind = 'tattoo':
				glqs_bz_cur = pcs_tattoos[$glqs_field[1]]
			else
				glqs_bz_cur = pcs_piercings[$glqs_field[1]]
			end
			$glqs_tbl += '<tr><td><a href="exec: gt ''mod_GLQS_main'', ''bodymod_design_menu'', ''' + $glqs_bz_kind + ''', ''' + $glqs_field[1] + '''">' + $glqs_field[2] + '</a></td><td>' + $iif(glqs_bz_cur > 0, '[' + $str(glqs_bz_cur) + ']', '') + '</td></tr>'
		end
		glqs_bz_i += 1
		jump 'glqs_bodymod_zone_loop'
	end
	$glqs_tbl += '</table>'
	$glqs_tbl
	killvar '$glqs_tbl'
	*nl
	killvar 'glqs_bz_i'
	killvar 'glqs_bz_cur'
	killvar '$glqs_bz_kind'
	killvar '$glqs_field'
	killvar '$glqs_bz'

	act 'Return': gt 'mod_GLQS_main', 'bodymod_menu'
	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end


if $ARGS[0] = 'bodymod_design_menu':
	!! ARGS[1] = tattoo or piercing, ARGS[2] = the zone/slot name. Copied into
	!! globals because the acts below read them at click time, after this call
	!! and its $ARGS are gone.
	!! Tattoos and piercings differ only in which manager location and which
	!! pcs_* array they use; everything else about the two screens was identical.
	$glqs_bm_kind = $ARGS[1]
	$glqs_bm_zone = $ARGS[2]
	if $glqs_bm_kind = 'tattoo':
		$glqs_bm_mgr = 'tattoo_management'
		$glqs_bm_title = 'Tattoo Designs'
		$glqs_bm_backlabel = 'Back to Zones'
		$glqs_bm_remove = 'Remove Tattoo From This Zone'
	else
		$glqs_bm_mgr = 'piercing_management'
		$glqs_bm_title = 'Piercing Jewelry'
		$glqs_bm_backlabel = 'Back to Slots'
		$glqs_bm_remove = 'Remove Piercing From This Slot'
	end
	gs 'mod_GLQS_main', 'screen_head'
	!! Own variable rather than the games scratch global total.
	glqs_bm_total = func($glqs_bm_mgr, 'get_total', $glqs_bm_zone)
	'<center><b><font color="maroon"><<$glqs_bm_title>>: <<$glqs_bm_zone>></font></b></center>'
	'<br><<glqs_bm_total>> designs available. Click an image to apply it.'
	*nl
	$glqs_grid = '<div style="display:flex; flex-wrap:wrap; gap:8px;">'
	glqs_bm_i = 1
	:glqs_bm_img_loop
	if glqs_bm_i <= glqs_bm_total:
		!! The managers generic image route returns a string, so it is called
		!! through $func (the per-zone _image routes set $result too).
		$glqs_grid += '<div style="flex:0 0 auto;"><a href="exec: gs ''<<$glqs_bm_mgr>>'', ''add'', ''<<$glqs_bm_zone>>'', <<glqs_bm_i>> & gs ''stat'' & gt ''mod_GLQS_main'', ''bodymod_design_menu'', ''<<$glqs_bm_kind>>'', ''<<$glqs_bm_zone>>''"><img height="220" src="<<$func($glqs_bm_mgr, ''image'', $glqs_bm_zone, glqs_bm_i)>>"></a></div>'
		glqs_bm_i += 1
		jump 'glqs_bm_img_loop'
	end
	killvar 'glqs_bm_i'
	killvar 'glqs_bm_total'
	$glqs_grid += '</div>'
	$glqs_grid
	killvar '$glqs_grid'
	*nl

	!! Read after screen_head, since the gs stat inside it can update these.
	if $glqs_bm_kind = 'tattoo':
		glqs_bm_cur = pcs_tattoos[$glqs_bm_zone]
	else
		glqs_bm_cur = pcs_piercings[$glqs_bm_zone]
	end
	if glqs_bm_cur > 0:
		act '<<$glqs_bm_remove>>':
			gs $glqs_bm_mgr, 'remove', $glqs_bm_zone
			gs 'stat'
			gt 'mod_GLQS_main', 'bodymod_design_menu', $glqs_bm_kind, $glqs_bm_zone
		end
	end
	killvar 'glqs_bm_cur'

	!! The $glqs_bm_* strings are NOT killed here - the acts above and below
	!! reference them directly, and QSP resolves act bodies at click time, not at
	!! definition time. Killing them here would clear them before the player
	!! could ever click, same stray-killvar bug as fame_detail (see comment
	!! there). No Return to Top Menu, matching the v0.28.1 decision that Back
	!! already covers it at this depth.
	act '<<$glqs_bm_backlabel>>': gt 'mod_GLQS_main', 'bodymod_zone_menu', $glqs_bm_kind
end


