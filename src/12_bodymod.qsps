!! BODY MODS + TATTOO/PIERCING PICKERS
if $ARGS[0] = 'bodymod_menu':
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Body Mods</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'bodymod_menu'
	'<br>Electrolysis is free through this menu (normally 80,000 RUB at the clinic).'
	*nl
	$glqs_tbl = ''
	$glqs_tbl += '<table width="80%" cellpadding=4>'
	$glqs_tbl += '<tr><td>Leg hair</td><td><<iif(pcs_leghair = 0, ''Removed'', ''Present'')>></td></tr>'
	$glqs_tbl += '<tr><td>Pubic hair</td><td><<iif(pcs_pubes = 0, ''Removed'', ''Present'')>></td></tr>'
	$glqs_tbl += '<tr><td>Tattoos</td><td><<pcs_tattoos[''total'']>> / 18 zones</td></tr>'
	$glqs_tbl += '<tr><td>Piercings</td><td><<pcs_piercings[''total'']>> / 8 slots</td></tr>'
	$glqs_tbl += '<tr><td>Attractiveness</td><td><<pcs_apprnc>> (<<pcs_hotcat>>/10)</td></tr>'
	$glqs_tbl += '</table>'
	$glqs_tbl
	*nl

	act 'Free Electrolysis (permanent hair removal)':
		pcs_leghair = 0
		pcs_pubes = 0
		lashair = 1
		gs 'stat'
		gt 'mod_GLQS_main', 'bodymod_menu'
	end

	act 'Max Attractiveness (resets nightly, click again to reapply)':
		gs 'mod_GLQS_main', 'max_attractiveness'
		gt 'mod_GLQS_main', 'bodymod_menu'
	end

	act 'Choose a Tattoo': gt 'mod_GLQS_main', 'tattoo_zone_menu'

	act 'Choose a Piercing': gt 'mod_GLQS_main', 'piercing_slot_menu'

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end


if $ARGS[0] = 'max_attractiveness':
	!! pcs_apprnc is not a settable stat - AppearanceSystem.qsrc recomputes it
	!! from pcs_apprncbase plus live clothing/accessories/grooming bonuses and
	!! penalties every time gs stat runs (gs stat -> gs body, Update_Appearance
	!! -> gs AppearanceSystem), and CalcAppearance clamps that whole sum to
	!! 0-200 before adding a separate supernatural bonus on top. Rather than
	!! reverse engineering and maxing every underlying clothing-quality and
	!! body-composition input individually (CalcClothingBonus and
	!! CalcAccessoriesBonus in outfit.qsrc, and the BMI-dependent logic inside
	!! CalcBodyShapeBonus), setting pcs_apprncbase itself to a large value
	!! guarantees the 0-200 clamp always saturates at the max regardless of
	!! what is worn or
	!! current body composition - confirmed against both reference/0.9.8.3 and
	!! reference/nightly, which use an identical clamp formula (only the
	!! separate supernatural-bonus term differs between the two, which this
	!! does not touch, so any archetype/succubus bonus a save already has
	!! still applies normally on top of the guaranteed 200).
	!! pcs_apprncbase is only recalculated by an explicit
	!! gs AppearanceSystem, UpdateBaseAppearance call (daily at midnight, or a
	!! few specific cheats/spells) - never by gs stat - so this override
	!! persists across menus until the next in-game day, same as School
	!! Grades resetting weekly.
	pcs_apprncbase = 1000
	gs 'stat'
end


!! ===== TATTOO PICKER =====

if $ARGS[0] = 'tattoo_zone_menu':
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Choose a Tattoo Zone</font></b></center>'
	'<br>Pick a body zone, then pick a design. Current tattoo shown in brackets.'
	*nl

	act 'Ankle <<iif(pcs_tattoos[''ankle''] > 0, ''['' + pcs_tattoos[''ankle''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'ankle'
	act 'Arm <<iif(pcs_tattoos[''arm''] > 0, ''['' + pcs_tattoos[''arm''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'arm'
	act 'Ass <<iif(pcs_tattoos[''ass''] > 0, ''['' + pcs_tattoos[''ass''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'ass'
	act 'Back <<iif(pcs_tattoos[''back''] > 0, ''['' + pcs_tattoos[''back''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'back'
	act 'Belly <<iif(pcs_tattoos[''belly''] > 0, ''['' + pcs_tattoos[''belly''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'belly'
	act 'Breast <<iif(pcs_tattoos[''breast''] > 0, ''['' + pcs_tattoos[''breast''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'breast'
	act 'Chest <<iif(pcs_tattoos[''chest''] > 0, ''['' + pcs_tattoos[''chest''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'chest'
	act 'Face <<iif(pcs_tattoos[''face''] > 0, ''['' + pcs_tattoos[''face''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'face'
	act 'Hand <<iif(pcs_tattoos[''hand''] > 0, ''['' + pcs_tattoos[''hand''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'hand'
	act 'Leg <<iif(pcs_tattoos[''leg''] > 0, ''['' + pcs_tattoos[''leg''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'leg'
	act 'Lip <<iif(pcs_tattoos[''lip''] > 0, ''['' + pcs_tattoos[''lip''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'lip'
	act 'Neck <<iif(pcs_tattoos[''neck''] > 0, ''['' + pcs_tattoos[''neck''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'neck'
	act 'Pussy <<iif(pcs_tattoos[''pussy''] > 0, ''['' + pcs_tattoos[''pussy''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'pussy'
	act 'Shoulder <<iif(pcs_tattoos[''shoulder''] > 0, ''['' + pcs_tattoos[''shoulder''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'shoulder'
	act 'Side <<iif(pcs_tattoos[''side''] > 0, ''['' + pcs_tattoos[''side''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'side'
	act 'Tramp Stamp <<iif(pcs_tattoos[''tramp''] > 0, ''['' + pcs_tattoos[''tramp''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'tramp'
	act 'Underboob <<iif(pcs_tattoos[''under''] > 0, ''['' + pcs_tattoos[''under''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'under'
	act 'Wrist <<iif(pcs_tattoos[''wrist''] > 0, ''['' + pcs_tattoos[''wrist''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'tattoo', 'wrist'

	act 'Return': gt 'mod_GLQS_main', 'bodymod_menu'
	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end


if $ARGS[0] = 'bodymod_design_menu':
	!! ARGS[1] = tattoo or piercing, ARGS[2] = the zone/slot name. Captured
	!! before any nested gs call - $ARGS is one shared array in QSP, not scoped
	!! per gosub, so screen_head below would clobber them first.
	!! Tattoos and piercings differ only in which manager location and which
	!! pcs_* array they use; everything else about the two screens was identical.
	$glqs_bm_kind = $ARGS[1]
	$glqs_bm_zone = $ARGS[2]
	if $glqs_bm_kind = 'tattoo':
		$glqs_bm_mgr = 'tattoo_management'
		$glqs_bm_title = 'Tattoo Designs'
		$glqs_bm_back = 'tattoo_zone_menu'
		$glqs_bm_backlabel = 'Back to Zones'
		$glqs_bm_remove = 'Remove Tattoo From This Zone'
	else
		$glqs_bm_mgr = 'piercing_management'
		$glqs_bm_title = 'Piercing Jewelry'
		$glqs_bm_back = 'piercing_slot_menu'
		$glqs_bm_backlabel = 'Back to Slots'
		$glqs_bm_remove = 'Remove Piercing From This Slot'
	end
	gs 'mod_GLQS_main', 'screen_head'
	total = func($glqs_bm_mgr, 'get_total', $glqs_bm_zone)
	'<center><b><font color="maroon"><<$glqs_bm_title>>: <<$glqs_bm_zone>></font></b></center>'
	'<br><<total>> designs available. Click an image to apply it.'
	*nl
	$glqs_grid = '<div style="display:flex; flex-wrap:wrap; gap:8px;">'
	glqs_i = 1
	:glqs_bm_img_loop
	if glqs_i <= total:
		$glqs_grid += '<div style="flex:0 0 auto;"><a href="exec: gs ''<<$glqs_bm_mgr>>'', ''add'', ''<<$glqs_bm_zone>>'', <<glqs_i>> & gs ''stat'' & gt ''mod_GLQS_main'', ''bodymod_design_menu'', ''<<$glqs_bm_kind>>'', ''<<$glqs_bm_zone>>''"><img height="220" src="<<func($glqs_bm_mgr, $glqs_bm_zone + ''_image'', glqs_i)>>"></a></div>'
		glqs_i += 1
		jump 'glqs_bm_img_loop'
	end
	killvar 'glqs_i'
	$glqs_grid += '</div>'
	$glqs_grid
	*nl

	!! Read after screen_head, since the gs stat inside it can update these.
	if $glqs_bm_kind = 'tattoo':
		glqs_bm_cur = pcs_tattoos[$glqs_bm_zone]
	else
		glqs_bm_cur = pcs_piercings[$glqs_bm_zone]
	end
	if glqs_bm_cur > 0:
		act '<<$glqs_bm_remove>>':
			gs $glqs_bm_mgr, 'remove', $glqs_bm_zone
			gs 'stat'
			gt 'mod_GLQS_main', 'bodymod_design_menu', $glqs_bm_kind, $glqs_bm_zone
		end
	end
	killvar 'glqs_bm_cur'

	!! The $glqs_bm_* strings are NOT killed here - the acts above and below
	!! reference them directly, and QSP resolves act bodies at click time, not at
	!! definition time. Killing them here would clear them before the player
	!! could ever click, same stray-killvar bug as fame_detail (see comment
	!! there). No Return to Top Menu, matching the v0.28.1 decision that Back
	!! already covers it at this depth.
	act '<<$glqs_bm_backlabel>>': gt 'mod_GLQS_main', $glqs_bm_back
end


!! ===== PIERCING PICKER =====

if $ARGS[0] = 'piercing_slot_menu':
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Choose a Piercing Slot</font></b></center>'
	'<br>Pick a slot, then pick jewelry. Currently worn design shown in brackets.'
	*nl

	act 'Ears <<iif(pcs_piercings[''ears''] > 0, ''['' + pcs_piercings[''ears''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'piercing', 'ears'
	act 'Nose <<iif(pcs_piercings[''nose''] > 0, ''['' + pcs_piercings[''nose''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'piercing', 'nose'
	act 'Eyebrow <<iif(pcs_piercings[''brow''] > 0, ''['' + pcs_piercings[''brow''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'piercing', 'brow'
	act 'Lip <<iif(pcs_piercings[''lip''] > 0, ''['' + pcs_piercings[''lip''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'piercing', 'lip'
	act 'Tongue <<iif(pcs_piercings[''tongue''] > 0, ''['' + pcs_piercings[''tongue''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'piercing', 'tongue'
	act 'Navel <<iif(pcs_piercings[''navel''] > 0, ''['' + pcs_piercings[''navel''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'piercing', 'navel'
	act 'Nipples <<iif(pcs_piercings[''nipples''] > 0, ''['' + pcs_piercings[''nipples''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'piercing', 'nipples'
	act 'Pussy <<iif(pcs_piercings[''pussy''] > 0, ''['' + pcs_piercings[''pussy''] + '']'', '''')>>': gt 'mod_GLQS_main', 'bodymod_design_menu', 'piercing', 'pussy'

	act 'Return': gt 'mod_GLQS_main', 'bodymod_menu'
	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end
