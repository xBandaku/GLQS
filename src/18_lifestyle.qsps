!! LIFESTYLE SUBMENU
!! Bundles three small, self-contained systems that do not each warrant their
!! own top-level menu entry - same reasoning as Recurrent Cheats bundling
!! many small unrelated toggles under one roof.
if $ARGS[0] = 'lifestyle_menu':
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Lifestyle</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'lifestyle_menu'
	*nl

	$glqs_tbl = ''
	$glqs_tbl += '<table width="80%" cellpadding=4>'
	$glqs_tbl += '<tr><td>Casino chips</td><td><<casino_chips>></td></tr>'
	$glqs_tbl += '<tr><td>Pain level</td><td><<pain[''total'']>></td></tr>'
	$glqs_tbl += '</table>'
	$glqs_tbl
	killvar '$glqs_tbl'
	*nl

	act 'Max Casino Chips':
		!! casino_chips is capped at 1000 by the games own cashier/buy-in
		!! logic (casino.qsrc) - matching that cap here rather than a bigger
		!! number that only the cashier UI would silently clamp anyway.
		casino_chips = 1000
		gt 'mod_GLQS_main', 'lifestyle_menu'
	end

	act 'Clear All Pain':
		!! Reuses the base games own cheat handler exactly - pain[total] is
		!! recomputed from every pain[<bodypart>] entry plus vgape/agape/
		!! spanked, not an independent value, so killvar-ing the whole array
		!! and recalculating is the real reset, not just zeroing total.
		killvar 'pain'
		gs 'pain', 'calc'
		gt 'mod_GLQS_main', 'lifestyle_menu'
	end

	'<b>Fetish Preferences & Experience</b> (0-100 experience, -100 to 100 preference)'
	$glqs_tbl2 = '<table width="80%" cellpadding=3>'
	$glqs_tbl2 += '<tr><th align="left">Fetish</th><th align="left">Experience</th><th align="left">Preference</th></tr>'
	glqs_lf_i = 0
	:glqs_fetish_render_loop
	if glqs_lf_i < arrsize('$fetish_name'):
		$glqs_lf_key = $fetish_name[glqs_lf_i]
		$glqs_tbl2 += '<tr><td>' + $glqs_lf_key + '</td><td>' + fetishes[$glqs_lf_key + '_exp'] + '</td><td>' + fetishes[$glqs_lf_key + '_pref'] + '</td></tr>'
		glqs_lf_i += 1
		jump 'glqs_fetish_render_loop'
	end
	$glqs_tbl2 += '</table>'
	$glqs_tbl2
	killvar '$glqs_tbl2'
	*nl

	killvar 'glqs_lf_i'
	killvar '$glqs_lf_key'

	act 'Max All Fetish Experience':
		gs 'mod_GLQS_main', 'fetish_max_all', 'set_exp'
		gt 'mod_GLQS_main', 'lifestyle_menu'
	end

	act 'Max All Fetish Preferences':
		gs 'mod_GLQS_main', 'fetish_max_all', 'set_pref'
		gt 'mod_GLQS_main', 'lifestyle_menu'
	end

	'<b>Phone Plans</b>'
	$glqs_tbl3 = '<table width="80%" cellpadding=3>'
	$glqs_tbl3 += '<tr><td>Mobile Internet</td><td>' + $iif(subscription['mobile'] = 1, 'Active', 'Inactive') + '</td></tr>'
	$glqs_tbl3 += '<tr><td>Calls &amp; Texts</td><td>' + $iif(subscription['monthly_calls'] = 1, 'Active', 'Inactive') + '</td></tr>'
	$glqs_tbl3 += '</table>'
	$glqs_tbl3
	killvar '$glqs_tbl3'
	*nl

	act 'Grant Unlimited Phone Plans':
		!! Bypasses the games own bankAccount <> 0 purchase gate and the
		!! monthly charge entirely - price/discount 0 means a renewal (if
		!! one ever ran) would cost nothing, and date 0 matches the built-in
		!! free plans own never-expires convention (internet_mobile.qsrc),
		!! so check_subscription_actions never even tries to renew these.
		gs 'internet_mobile', 'buy_subscription', 'mobile', 0, 0
		subscription['mobile-date'] = 0
		gs 'internet_mobile', 'buy_subscription', 'monthly_calls', 0, 0
		subscription['monthly_calls-date'] = 0
		gt 'mod_GLQS_main', 'lifestyle_menu'
	end

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end


if $ARGS[0] = 'fetish_max_all':
	!! ARGS[1] = the fetish handler to call for every fetish: set_exp or set_pref.
	glqs_lf_i = 0
	:glqs_fetish_max_loop
	if glqs_lf_i < arrsize('$fetish_name'):
		gs 'fetish', $ARGS[1], $fetish_name[glqs_lf_i], 100
		glqs_lf_i += 1
		jump 'glqs_fetish_max_loop'
	end
	killvar 'glqs_lf_i'
end
