!! SCHOOL GRADES SUBMENU
if $ARGS[0] = 'grades':
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Grades & Academics</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'grades'
	'<br>Only applies on school start. Grades reset weekly based on class attendance.'
	*nl
	gs 'mod_GLQS_main', 'grades_data'
	$glqs_tbl = '<table width="80%" cellpadding=4>'
	glqs_grade_i = 0
	:glqs_grade_table_loop
	if glqs_grade_i < arrsize('$glqs_grade'):
		!! Row format is code|label.
		gs 'mod_GLQS_main', 'split_row', $glqs_grade[glqs_grade_i]
		$glqs_tbl += '<tr><td>' + $glqs_field[1] + '</td><td>' + class['school_' + $glqs_field[0] + '_grade'] + '</td></tr>'
		glqs_grade_i += 1
		jump 'glqs_grade_table_loop'
	end
	$glqs_tbl += '<tr><td>Absences</td><td><<gschoolVars[''absence_count'']>></td></tr>'
	$glqs_tbl += '<tr><td>University</td><td><<$iif(university[''student''] = 1, ''Enrolled ('' + $university[''enrolled_in''] + '')'', ''Not enrolled'')>></td></tr>'
	$glqs_tbl += '<tr><td>University diploma</td><td><<$iif(university[''diploma''] > 0, ''Yes'', ''No'')>></td></tr>'
	$glqs_tbl += '</table>'
	$glqs_tbl
	killvar '$glqs_tbl'
	*nl
	killvar 'glqs_grade_i'
	killvar '$glqs_field'
	killvar '$glqs_grade'

	act 'Set All Grades to 100':
		gs 'mod_GLQS_main', 'grades_max'
		gt 'mod_GLQS_main', 'grades'
	end

	act 'Zero Absences':
		gschoolVars['absence_count'] = 0
		gt 'mod_GLQS_main', 'grades'
	end

	if university['student'] = 0:
		act 'Force Enroll - Nursing':
			gs 'uni_admin', 'courses', 'enroll_nursing', 1
			gt 'mod_GLQS_main', 'grades'
		end

		act 'Force Enroll - Teaching Studies':
			gs 'uni_admin', 'courses', 'enroll_teaching', 1
			gt 'mod_GLQS_main', 'grades'
		end
	end

	if university['diploma'] = 0:
		act 'Grant University Diploma':
			!! Deliberately not attempting to instant-pass semester-by-semester
			!! grades - each semesters classes are created by the real
			!! enroll_* gosub with grade formulas that reference the prior
			!! semesters grade (uni_admin.qsrc), and $university[semester_passed]
			!! vs semeter_passed] is a base-game variable-name typo pair used
			!! inconsistently between files - not confidently safe to drive by
			!! hand. Jumping straight to the diploma flag skips that
			!! entirely instead of risking a half-consistent semester state.
			university['diploma'] = 1
			gt 'mod_GLQS_main', 'grades'
		end
	end

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end


if $ARGS[0] = 'grades_max':
	!! Loads the grade table itself instead of relying on whatever the grades
	!! screen left behind, so the table does not have to survive in the save.
	!! Absences are cleared too, because the game recomputes grades weekly
	!! from attendance.
	gs 'mod_GLQS_main', 'grades_data'
	glqs_gm_i = 0
	:glqs_grade_set_loop
	if glqs_gm_i < arrsize('$glqs_grade'):
		gs 'mod_GLQS_main', 'split_row', $glqs_grade[glqs_gm_i]
		gs 'grades', 'grade_award', 'school', $glqs_field[0], 100
		glqs_gm_i += 1
		jump 'glqs_grade_set_loop'
	end
	gschoolVars['absence_count'] = 0
	killvar 'glqs_gm_i'
	killvar '$glqs_field'
	killvar '$glqs_grade'
end

