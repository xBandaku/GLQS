!! RECURRENT CHEATS SUBMENU + ON/OFF HANDLERS
if $ARGS[0] = 'recurrent':
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Recurrent Cheats</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'recurrent'
	*nl
	'Each row below toggles individually on click; Enable All / Disable All further down still set all of them at once:'
	*nl
	gs 'mod_GLQS_main', 'recurrent_data'
	$glqs_tbl = '<table width="80%" cellpadding=4>'
	glqs_rc_i = 0
	:glqs_recurrent_render_loop
	if glqs_rc_i < arrsize('$glqs_rc'):
		!! Row format is role|cheatVars key|arg|label.
		gs 'mod_GLQS_main', 'split_row', $glqs_rc[glqs_rc_i]
		$glqs_rcp_role = $glqs_field[0]
		$glqs_rcp_key = $glqs_field[1]
		$glqs_rcp_arg = $glqs_field[2]
		$glqs_rcp_label = $glqs_field[3]
		!! suc_bimbo only matters while clothing archetypes are on, and the base
		!! games own cheat menu hides it otherwise (cheatmenu_din.qsrc).
		if $glqs_rcp_key <> 'suc_bimbo' or cheatVars['bimbo'] = 0:
			if $glqs_rcp_role = 'special':
				$glqs_rc_link = 'gs ''cheatmenu_din'', ''' + $glqs_rcp_arg + ''''
			else
				$glqs_rc_link = 'cheatVars[''' + $glqs_rcp_key + '''] = iif(cheatVars[''' + $glqs_rcp_key + '''] > 0, 0, ' + $glqs_rcp_arg + ')'
			end
			$glqs_tbl += '<tr><td>' + $glqs_rcp_label + '</td><td><a href="exec: ' + $glqs_rc_link + ' & gt ''mod_GLQS_main'', ''recurrent''">' + $iif(cheatVars[$glqs_rcp_key] > 0, 'Enabled', 'Disabled') + '</a></td></tr>'
		end
		glqs_rc_i += 1
		jump 'glqs_recurrent_render_loop'
	end
	$glqs_tbl += '</table>'
	$glqs_tbl
	killvar '$glqs_tbl'
	*nl
	killvar 'glqs_rc_i'
	killvar '$glqs_rc_link'
	gs 'mod_GLQS_main', 'recurrent_clear'

	act 'Enable All':
		gs 'mod_GLQS_main', 'recurrent_set', 1
		gt 'mod_GLQS_main', 'recurrent'
	end

	act 'Disable All':
		gs 'mod_GLQS_main', 'recurrent_set', 0
		gt 'mod_GLQS_main', 'recurrent'
	end

	act 'Clear Addiction Levels':
		gs 'mod_GLQS_main', 'clear_addiction'
		gt 'mod_GLQS_main', 'recurrent'
	end

	'<b>Individual toggles</b> (each affects related in-game state, e.g. resetting clothing-archetype trait levels or a periods cycle, so they are not bundled into Enable/Disable All above):'
	*nl
	$glqs_tbl2 = ''
	$glqs_tbl2 += '<table width="80%" cellpadding=4>'
	$glqs_tbl2 += '<tr><td>Clothing archetypes (normal game behavior)</td><td><a href="exec: gs ''cheatmenu_din'', ''BimboCloth'' & gt ''mod_GLQS_main'', ''recurrent''"><<$iif(cheatVars[''bimbo''], ''Disabled'', ''Enabled'')>></a></td></tr>'
	$glqs_tbl2 += '<tr><td>Periods and pregnancies</td><td><a href="exec: gs ''cheatmenu_din'', ''slutshot'' & gt ''mod_GLQS_main'', ''recurrent''"><<$iif(cheatVars[''no_periods''], ''Disabled'', ''Enabled'')>></a></td></tr>'
	!! Impregnation only matters while periods are enabled - conception in
	!! femcyc.qsrc runs off the ovulate flag, which is only ever set during
	!! the normal cycle (cyc1 -> cyc2 transition); slutshot pins cycle at 6
	!! when periods are disabled, so that transition never happens and
	!! ovulate never gets set, making this toggle a silent no-op in that
	!! state. The base games own cheat menu hides this row for the same
	!! reason (cheatmenu_din.qsrc, permanent handler) - mirrored here rather
	!! than showing a control that looks live but does nothing.
	if cheatVars['no_periods'] = 0:
		$glqs_tbl2 += '<tr><td>&nbsp;&nbsp;Impregnation</td><td><a href="exec: cheatVars[''no_pregnancy''] = iif(cheatVars[''no_pregnancy''], 0, 1) & gt ''mod_GLQS_main'', ''recurrent''"><<$iif(cheatVars[''no_pregnancy''], ''Disabled'', ''Enabled'')>></a></td></tr>'
	end
	$glqs_tbl2 += '<tr><td>Lactation</td><td><a href="exec: cheatVars[''no_lactation''] = iif(cheatVars[''no_lactation''], 0, 1) & gt ''mod_GLQS_main'', ''recurrent''"><<$iif(cheatVars[''no_lactation''], ''Disabled'', ''Enabled'')>></a></td></tr>'
	$glqs_tbl2 += '<tr><td>Cum leaking</td><td><a href="exec: cheatVars[''no_cum_leak''] = iif(cheatVars[''no_cum_leak''], 0, 1) & gt ''mod_GLQS_main'', ''recurrent''"><<$iif(cheatVars[''no_cum_leak''], ''Disabled'', ''Enabled'')>></a></td></tr>'
	$glqs_tbl2 += '<tr><td>STDs</td><td><a href="exec: cheatVars[''std''] = iif(cheatVars[''std''], 0, 1) & gt ''mod_GLQS_main'', ''recurrent''"><<$iif(cheatVars[''std''], ''Disabled'', ''Enabled'')>></a></td></tr>'
	$glqs_tbl2 += '</table>'
	$glqs_tbl2
	killvar '$glqs_tbl2'
	*nl

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end


if $ARGS[0] = 'recurrent_set':
	!! ARGS[1] = 1 to enable every toggle in recurrent_data, 0 to disable.
	glqs_rs_on = ARGS[1]
	gs 'mod_GLQS_main', 'recurrent_data'
	glqs_rs_i = 0
	:glqs_recurrent_set_loop
	if glqs_rs_i < arrsize('$glqs_rc'):
		gs 'mod_GLQS_main', 'split_row', $glqs_rc[glqs_rs_i]
		$glqs_rcp_role = $glqs_field[0]
		$glqs_rcp_key = $glqs_field[1]
		$glqs_rcp_arg = $glqs_field[2]
		if $glqs_rcp_role = 'special':
			if (cheatVars[$glqs_rcp_key] > 0) <> (glqs_rs_on > 0):
				gs 'cheatmenu_din', $glqs_rcp_arg
			end
		!! suc_bimbo is hidden while archetypes are off, and enabling it then
		!! would leave a cheat the player can neither see nor clear here.
		!! Clearing is always allowed, so Disable All still reaches it.
		elseif $glqs_rcp_key <> 'suc_bimbo' or cheatVars['bimbo'] = 0 or glqs_rs_on = 0:
			cheatVars[$glqs_rcp_key] = iif(glqs_rs_on, val($glqs_rcp_arg), 0)
		end
		glqs_rs_i += 1
		jump 'glqs_recurrent_set_loop'
	end
	killvar 'glqs_rs_i'
	killvar 'glqs_rs_on'
	gs 'mod_GLQS_main', 'recurrent_clear'
end


if $ARGS[0] = 'clear_addiction':
	!! The immunity toggle (drugs_immune) only stops NEW addiction from
	!! accumulating - it never touches dependency built up before it was
	!! turned on, so a save with prior drug use keeps suffering withdrawal
	!! even with the toggle enabled. This clears the dependency and
	!! withdrawal counters drugs.qsrc reads.
	drugVars['painkiller_tolerance'] = 0
	drugVars['painkiller_addict'] = 0
	drugVars['painkiller_points'] = 0
	drugVars['painkiller_need'] = 0
	drugVars['caffeine_addict'] = 0
	drugVars['caffeine_need'] = 0
	drugVars['caffeine_dose'] = 0
	drugVars['caffeine_system'] = 0
	drugVars['cocaine_system'] = 0
	drugVars['cocaine_addict'] = 0
	drugVars['cocaine_need'] = 0
	drugVars['heroin_used'] = 0
	drugVars['heroin_need'] = 0
	drugVars['heroin_hours_addicted'] = 0
	drugVars['heroin_taper'] = 0
	drugVars['cigarettes_need'] = 0
	drugVars['amphetamine_used'] = 0
	drugVars['amphetamine_withdrawl'] = 0
end
