!! JOBS & CAREER SUBMENU
if $ARGS[0] = 'jobs_menu':
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Jobs & Career</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'jobs_menu'
	*nl

	gs 'mod_GLQS_main', 'job_list_build'
	!! Row format is id|title. One pass builds an id -> title lookup for the
	!! held-jobs table; $job_title is only filled lazily by the game.
	glqs_jm_i = 0
	:glqs_jobs_title_loop
	if glqs_jm_i < arrsize('$glqs_jb'):
		gs 'mod_GLQS_main', 'split_row', $glqs_jb[glqs_jm_i]
		$glqs_jm_titles[$glqs_field[0]] = $glqs_field[1]
		glqs_jm_i += 1
		jump 'glqs_jobs_title_loop'
	end

	glqs_jm_held = arrsize('$job_list')
	if glqs_jm_held > 0:
		'<b>Current jobs</b>'
		$glqs_tbl = '<table width="80%" cellpadding=3>'
		$glqs_tbl += '<tr><th align="left">Job</th><th align="left">Rank</th><th align="left">Pay Rate</th><th align="left"></th></tr>'
		glqs_jm_i = 0
		:glqs_jobs_held_loop
		if glqs_jm_i < glqs_jm_held:
			$glqs_jm_id = $job_list[glqs_jm_i]
			$glqs_jm_title = $glqs_jm_titles[$glqs_jm_id]
			if $glqs_jm_title = '': $glqs_jm_title = $glqs_jm_id
			$glqs_tbl += '<tr><td>' + $glqs_jm_title + '</td><td>' + job_rank[$glqs_jm_id] + '</td><td>' + job_pay_rate[$glqs_jm_id] + '</td><td>'
			$glqs_tbl += '<a href="exec: gs ''jobs'', ''set_rank'', ''' + $glqs_jm_id + ''', 5 & gt ''mod_GLQS_main'', ''jobs_menu''">Max Rank</a> '
			$glqs_tbl += '<a href="exec: job_pay_rate[''' + $glqs_jm_id + '''] = job_pay_rate[''' + $glqs_jm_id + '''] * 10 & gt ''mod_GLQS_main'', ''jobs_menu''">Boost Pay</a> '
			$glqs_tbl += '<a href="exec: job_missed_total[''' + $glqs_jm_id + '''] = 0 & job_miss_acknowledged[''' + $glqs_jm_id + '''] = 0 & job_booking_debt[''' + $glqs_jm_id + '''] = 0 & job_docked_pay[''' + $glqs_jm_id + '''] = 0 & gt ''mod_GLQS_main'', ''jobs_menu''">Clear Penalties</a>'
			$glqs_tbl += '</td></tr>'
			glqs_jm_i += 1
			jump 'glqs_jobs_held_loop'
		end
		$glqs_tbl += '</table>'
		$glqs_tbl
		killvar '$glqs_tbl'
		*nl
	end

	'<b>Available jobs</b> (Instant-Hire skips the interview/hiring quest entirely, same as the games own cheatVars[show_hidden_jobs]/cheatVars[work] debug hooks):'
	$glqs_tbl2 = '<table width="80%" cellpadding=3>'
	glqs_jm_i = 0
	:glqs_jobs_all_loop
	if glqs_jm_i < arrsize('$glqs_jb'):
		gs 'mod_GLQS_main', 'split_row', $glqs_jb[glqs_jm_i]
		$glqs_jm_id = $glqs_field[0]
		$glqs_jm_title = $glqs_field[1]
		if $job_status[$glqs_jm_id] <> 'employed':
			$glqs_tbl2 += '<tr><td>' + $glqs_jm_title + '</td><td><a href="exec: gs ''jobs'', ''set_employed'', ''' + $glqs_jm_id + ''' & gt ''mod_GLQS_main'', ''jobs_menu''">Instant-Hire</a></td></tr>'
		end
		glqs_jm_i += 1
		jump 'glqs_jobs_all_loop'
	end
	$glqs_tbl2 += '</table>'
	$glqs_tbl2
	killvar '$glqs_tbl2'
	*nl

	killvar 'glqs_jm_held'
	killvar 'glqs_jm_i'
	killvar '$glqs_jm_id'
	killvar '$glqs_jm_title'
	killvar '$glqs_jm_titles'
	killvar '$glqs_field'
	killvar '$glqs_jb'

	act 'Ignore Job Schedule Conflicts':
		!! Reuses the games own existing debug hook (jobs.qsrc
		!! check_employment_possible) rather than reimplementing it.
		cheatVars['work'] = 1
		gt 'mod_GLQS_main', 'jobs_menu'
	end

	act 'Return to Top Menu': gt 'mod_GLQS_main', 'start'
end
