!! STATS ACTION HANDLER
if $ARGS[0] = 'stats':
	gs 'mod_GLQS_main', 'stats_data'
	glqs_sa_i = 0
	:glqs_stats_all_loop
	if glqs_sa_i < glqs_st_total:
		$glqs_sa_row = $glqs_st[glqs_sa_i]
		glqs_sa_p1 = instr($glqs_sa_row, '|')
		$glqs_sa_rest = $mid($glqs_sa_row, glqs_sa_p1 + 1)
		glqs_sa_p2 = instr($glqs_sa_rest, '|')
		$glqs_sa_kind = $mid($glqs_sa_rest, 1, glqs_sa_p2 - 1)
		$glqs_sa_rest2 = $mid($glqs_sa_rest, glqs_sa_p2 + 1)
		glqs_sa_p3 = instr($glqs_sa_rest2, '|')
		$glqs_sa_key = $mid($glqs_sa_rest2, 1, glqs_sa_p3 - 1)
		if $glqs_sa_kind = 'lvl': gs 'shortgs', 'setStat', $glqs_sa_key, 100
		if $glqs_sa_kind = 'cap': dyneval('<<$glqs_sa_key>> = 150')
		glqs_sa_i += 1
		jump 'glqs_stats_all_loop'
	end
	killvar 'glqs_sa_i' & killvar 'glqs_sa_p1' & killvar 'glqs_sa_p2' & killvar 'glqs_sa_p3'
	killvar '$glqs_sa_row' & killvar '$glqs_sa_rest' & killvar '$glqs_sa_rest2'
	killvar '$glqs_sa_kind' & killvar '$glqs_sa_key'
	killvar '$glqs_st' & killvar 'glqs_st_total'
	!! No direct pcs_vball_block/rec/serve/set/spike writes here - those five
	!! are derived stats, recomputed from vball_lvl plus attributes by
	!! stat_sklattrib_lvlset on every single gs stat call, so writing them
	!! directly is overwritten immediately. Maxing vball and the attributes
	!! above already maxes all five.
end
