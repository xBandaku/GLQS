!! MAIN MENU (start)
if $ARGS[0] = 'nav_build':
	!! One flat pipe-delimited array (key|label) of the 14 top-level
	!! submenus, shared by start (Index) and navbar so the two navigation
	!! renderers - buttons or text links, per glqs_nav_style - can never
	!! drift apart or list a different set of menus.
	!! Grouped by function - appearance, then character systems, then
	!! social, then economy/resources, with the toggle-heavy Recurrent
	!! Cheats last since its a meta menu rather than a character system.
	glqs_nb_n = 0
	$glqs_nb[glqs_nb_n] = 'clothing_menu|Clothing & Accessories' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'bodymod_menu|Body Mods' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'stats_menu|Skills & Attributes' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'health_menu|Health & Energy' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'grades|Grades & Academics' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'magic_menu|Magic' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'rel_menu|Relationships' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'fame_menu|Fame & Reputation' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'money_menu|Money' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'jobs_menu|Jobs & Career' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'housing_menu|Housing & Property' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'consumables_menu|Consumables' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'lifestyle_menu|Lifestyle' & glqs_nb_n += 1
	$glqs_nb[glqs_nb_n] = 'recurrent|Recurrent Cheats' & glqs_nb_n += 1
	glqs_nb_total = glqs_nb_n
	killvar 'glqs_nb_n'
end


if $ARGS[0] = 'start':
	menu_off = 0
	usehtml = 1
	$location_type = 'event'
	killvar '$locclass'
	gs 'core_library', 'setloc', 'mod_GLQS_main', 'start'
	gs 'stat'
	gs 'themes', 'indoors'
	'<center><b><font color="maroon">Quick Setup Mod</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'start'
	'<br>Instantly give your character everything she needs.'
	*nl

	act 'Return':
		$menu_loc = $shopreturn
		$menu_arg = $shoparg
		killvar '$shopreturn'
		killvar '$shoparg'
		gt $menu_loc, $menu_arg
	end
end


if $ARGS[0] = 'navbar':
	!! Quick-nav bar for the Index plus the 14 top-level submenus, shown
	!! under every ones own title (including the Index itself - previously
	!! the Index rendered its own separate 14-item list with no self-entry
	!! while every other page showed this 15-item one with one, so the bar
	!! visibly reshaped/rewrapped depending which page you were on; now
	!! every page renders the exact same list, the same way, with only the
	!! current page swapped from a link to bold text). Not on nested
	!! sub-screens (store detail, tattoo/piercing pickers, fame by region,
	!! etc.) - those already have their own Return/Back and adding this
	!! everywhere would be more clutter than shortcut.
	!! Respects glqs_nav_style: action buttons (default, matches how every
	!! other GLQS action already looks) or inline text links (a persistent
	!! row under the title, like the base games own Cheat Menu tab bar).
	!! ARGS[1] = the calling menus own routing key (e.g. recurrent), passed
	!! explicitly by every caller - $loc_arg turned out NOT to reflect this
	!! mods own internal gt calls (it only tracks real cross-location moves,
	!! and every GLQS screen shares the one mod_GLQS_main location, so it
	!! stayed stuck on whatever the very first entry set it to). Captured
	!! into $glqs_current before the nested gs nav_build call below, since
	!! $ARGS is one shared array in QSP and that call would otherwise
	!! clobber it first - same class of bug as every other nested-gs capture
	!! elsewhere in this mod.
	$glqs_current = $ARGS[1]
	if glqs_nav_style = 1:
		gs 'mod_GLQS_main', 'nav_build'
		$glqs_nav = '<center><font size="2">'
		$glqs_nav += '<font color="gray"><b>Text Links</b></font> | <a href="exec: glqs_nav_style = 0 & gt ''mod_GLQS_main'', ''' + $glqs_current + '''">Action Buttons</a><br>'
		$glqs_nav += iif($glqs_current = 'start', '<font color="gray"><b>Index</b></font>', '<a href="exec: gt ''mod_GLQS_main'', ''start''">Index</a>') + ' | '
		glqs_i = 0
		:glqs_navbar_link_loop
		if glqs_i < glqs_nb_total:
			$glqs_row = $glqs_nb[glqs_i]
			glqs_p1 = instr($glqs_row, '|')
			$glqs_key = $mid($glqs_row, 1, glqs_p1 - 1)
			$glqs_label = $mid($glqs_row, glqs_p1 + 1)
			if $glqs_key = $glqs_current:
				$glqs_nav += '<font color="gray"><b>' + $glqs_label + '</b></font>'
			else
				$glqs_nav += '<a href="exec: gt ''mod_GLQS_main'', ''' + $glqs_key + '''">' + $glqs_label + '</a>'
			end
			if glqs_i < glqs_nb_total - 1: $glqs_nav += ' | '
			glqs_i += 1
			jump 'glqs_navbar_link_loop'
		end
		$glqs_nav += '</font></center>'
		$glqs_nav
		*nl
		killvar 'glqs_i' & killvar 'glqs_p1' & killvar '$glqs_row' & killvar '$glqs_key' & killvar '$glqs_label'
		killvar '$glqs_nb' & killvar 'glqs_nb_total'
	else
		!! QSP resolves act bodies at click time, so build.py expands the
		!! single nav_build registry into literal actions here. Each entry
		!! is skipped on whichever page it points to, instead of bolded like
		!! the text-link branch above.
		act 'Switch Menu Display to Text Links': glqs_nav_style = 1 & gt 'mod_GLQS_main', $glqs_current
		if $glqs_current <> 'start': act 'Index': gt 'mod_GLQS_main', 'start'
		!! GLQS_NAV_ACTIONS_BEGIN
		!! GLQS_NAV_ACTIONS_END
	end
	!! $glqs_current is NOT killed here - the Switch Menu Display act above
	!! references it directly, and QSP resolves act bodies at click time,
	!! not at definition time. Killing it here would clear it before the
	!! player could ever click, same stray-killvar bug as the tattoo/
	!! piercing pickers elsewhere in this mod.
end

!! ===== CLOTHING MENU =====
