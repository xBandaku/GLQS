!! MAIN MENU (start)
if $ARGS[0] = 'nav_build':
	!! One flat pipe-delimited array (key|label) of the 14 top-level
	!! submenus, shared by start (Index) and navbar so the two navigation
	!! renderers - buttons or text links, per glqs_nav_style - can never
	!! drift apart or list a different set of menus.
	!! Grouped by function - appearance, then character systems, then
	!! social, then economy/resources, with the toggle-heavy Recurrent
	!! Cheats last since its a meta menu rather than a character system.
	killvar '$glqs_nb'
	$glqs_nb[] = 'clothing_menu|Clothing & Accessories'
	$glqs_nb[] = 'bodymod_menu|Body Mods'
	$glqs_nb[] = 'stats_menu|Skills & Attributes'
	$glqs_nb[] = 'health_menu|Health & Energy'
	$glqs_nb[] = 'grades|Grades & Academics'
	$glqs_nb[] = 'magic_menu|Magic'
	$glqs_nb[] = 'rel_menu|Relationships'
	$glqs_nb[] = 'fame_menu|Fame & Reputation'
	$glqs_nb[] = 'money_menu|Money'
	$glqs_nb[] = 'jobs_menu|Jobs & Career'
	$glqs_nb[] = 'housing_menu|Housing & Property'
	$glqs_nb[] = 'consumables_menu|Consumables'
	$glqs_nb[] = 'lifestyle_menu|Lifestyle'
	$glqs_nb[] = 'recurrent|Recurrent Cheats'
end


if $ARGS[0] = 'split_row':
	!! Splits ARGS[1] on | into $glqs_field[0], [1], ... in order. Every data
	!! table in this mod is a list of pipe-delimited rows, and each reader used
	!! to hand-write its own instr/mid chain - reading three fields from a
	!! four-field row that way is what broke store_buy in v0.36.1.
	!! Callers copy the fields they need before calling split_row again.
	killvar '$glqs_field'
	$glqs_sr_rest = $ARGS[1]
	:glqs_split_row_loop
	glqs_sr_p = instr($glqs_sr_rest, '|')
	if glqs_sr_p > 0:
		$glqs_field[] = $mid($glqs_sr_rest, 1, glqs_sr_p - 1)
		$glqs_sr_rest = $mid($glqs_sr_rest, glqs_sr_p + 1)
		jump 'glqs_split_row_loop'
	end
	$glqs_field[] = $glqs_sr_rest
	killvar '$glqs_sr_rest'
	killvar 'glqs_sr_p'
end


if $ARGS[0] = 'screen_head':
	!! The opener every GLQS screen shares. Deliberately does not print the
	!! title or call navbar - those differ per screen (nested sub-screens get
	!! no navbar at all, and two screens compute their title only after this
	!! point), so they stay at the call site.
	menu_off = 0
	usehtml = 1
	$location_type = 'event'
	gs 'stat'
	gs 'themes', 'indoors'
end


if $ARGS[0] = 'start':
	!! setloc also clears $locclass (core_library.qsrc), so the Index does
	!! not inherit the bedroom selfie context.
	gs 'core_library', 'setloc', 'mod_GLQS_main', 'start'
	gs 'mod_GLQS_main', 'screen_head'
	'<center><b><font color="maroon">Quick Setup Mod</font></b></center>'
	gs 'mod_GLQS_main', 'navbar', 'start'
	'<br>Instantly give your character everything she needs.'
	*nl
	'Quick Setup link in your room: <a href="exec: cheatVars[''cheatsp''] = iif(cheatVars[''cheatsp''], 0, 1) & gt ''mod_GLQS_main'', ''start''"><b><<$iif(cheatVars[''cheatsp''], ''Enabled'', ''Disabled'')>></b></a> (GLQS stays reachable from Settings > Mods and the cheat menu either way.)'
	*nl

	act 'Return': gs 'mod_GLQS_main', 'leave'
end


if $ARGS[0] = 'enter':
	!! Called by every link that opens GLQS, before gt start. ARGS[1] and
	!! ARGS[2] are the screen Return should go back to.
	!! start calls setloc, which overwrites the games own $loc/$loc_arg and
	!! $menu_loc/$menu_arg. The settings screen and the cheat menu both exit
	!! with gt $menu_loc, $menu_arg, so without this snapshot, opening GLQS
	!! from one of them and coming back would make its Exit lead into GLQS
	!! instead of to wherever the player really was.
	killvar '$glqs_lv_loc'
	killvar '$glqs_lv_arg'
	$glqs_ret_loc = $ARGS[1]
	$glqs_ret_arg = $ARGS[2]
	$glqs_saved_loc = $loc
	$glqs_saved_loc_arg = $loc_arg
	$glqs_saved_menu_loc = $menu_loc
	$glqs_saved_menu_arg = $menu_arg
end


if $ARGS[0] = 'leave':
	!! Restores what enter saved, then goes back. A save made inside GLQS by an
	!! older version has only $shopreturn/$shoparg, so those are the fallback.
	if $glqs_ret_loc = '':
		$glqs_ret_loc = $shopreturn
		$glqs_ret_arg = $shoparg
	end
	if $glqs_saved_loc <> '':
		$loc = $glqs_saved_loc
		$loc_arg = $glqs_saved_loc_arg
		$menu_loc = $glqs_saved_menu_loc
		$menu_arg = $glqs_saved_menu_arg
	end
	killvar '$glqs_saved_loc'
	killvar '$glqs_saved_loc_arg'
	killvar '$glqs_saved_menu_loc'
	killvar '$glqs_saved_menu_arg'
	killvar '$shopreturn'
	killvar '$shoparg'
	!! Copied out so the globals can be cleared before the gt, which ends
	!! this route.
	$glqs_lv_loc = $glqs_ret_loc
	$glqs_lv_arg = $glqs_ret_arg
	killvar '$glqs_ret_loc'
	killvar '$glqs_ret_arg'
	gt $glqs_lv_loc, $glqs_lv_arg
end


if $ARGS[0] = 'navbar':
	!! Quick-nav bar for the Index plus the 14 top-level submenus, shown
	!! under every ones own title (including the Index itself - previously
	!! the Index rendered its own separate 14-item list with no self-entry
	!! while every other page showed this 15-item one with one, so the bar
	!! visibly reshaped/rewrapped depending which page you were on; now
	!! every page renders the exact same list, the same way, with only the
	!! current page swapped from a link to bold text). Not on nested
	!! sub-screens (store detail, tattoo/piercing pickers, fame by region,
	!! etc.) - those already have their own Return/Back and adding this
	!! everywhere would be more clutter than shortcut.
	!! Respects glqs_nav_style: action buttons (default, matches how every
	!! other GLQS action already looks) or inline text links (a persistent
	!! row under the title, like the base games own Cheat Menu tab bar).
	!! ARGS[1] = the calling menus own routing key (e.g. recurrent), passed
	!! explicitly by every caller - $loc_arg turned out NOT to reflect this
	!! mods own internal gt calls (it only tracks real cross-location moves,
	!! and every GLQS screen shares the one mod_GLQS_main location, so it
	!! stayed stuck on whatever the very first entry set it to). Copied into
	!! the global $glqs_current because nav_build reads it, and the Switch
	!! Menu Display act below reads it at click time, after $ARGS is gone.
	$glqs_current = $ARGS[1]
	if glqs_nav_style = 1:
		gs 'mod_GLQS_main', 'nav_build'
		$glqs_nav = '<center><font size="2">'
		$glqs_nav += '<font color="gray"><b>Text Links</b></font> | <a href="exec: glqs_nav_style = 0 & gt ''mod_GLQS_main'', ''' + $glqs_current + '''">Action Buttons</a><br>'
		$glqs_nav += $iif($glqs_current = 'start', '<font color="gray"><b>Index</b></font>', '<a href="exec: gt ''mod_GLQS_main'', ''start''">Index</a>') + ' | '
		glqs_nv_i = 0
		glqs_nv_total = arrsize('$glqs_nb')
		:glqs_navbar_link_loop
		if glqs_nv_i < glqs_nv_total:
			gs 'mod_GLQS_main', 'split_row', $glqs_nb[glqs_nv_i]
			if $glqs_field[0] = $glqs_current:
				$glqs_nav += '<font color="gray"><b>' + $glqs_field[1] + '</b></font>'
			else
				$glqs_nav += '<a href="exec: gt ''mod_GLQS_main'', ''' + $glqs_field[0] + '''">' + $glqs_field[1] + '</a>'
			end
			if glqs_nv_i < glqs_nv_total - 1: $glqs_nav += ' | '
			glqs_nv_i += 1
			jump 'glqs_navbar_link_loop'
		end
		$glqs_nav += '</font></center>'
		$glqs_nav
		killvar '$glqs_nav'
		*nl
		killvar 'glqs_nv_i'
		killvar 'glqs_nv_total'
		killvar '$glqs_field'
		killvar '$glqs_nb'
	else
		!! QSP resolves act bodies at click time, so build.py expands the
		!! single nav_build registry into literal actions here. Each entry
		!! is skipped on whichever page it points to, instead of bolded like
		!! the text-link branch above.
		act 'Switch Menu Display to Text Links': glqs_nav_style = 1 & gt 'mod_GLQS_main', $glqs_current
		if $glqs_current <> 'start': act 'Index': gt 'mod_GLQS_main', 'start'
		!! GLQS_NAV_ACTIONS_BEGIN
		!! GLQS_NAV_ACTIONS_END
	end
	!! $glqs_current is NOT killed here - the Switch Menu Display act above
	!! references it directly, and QSP resolves act bodies at click time,
	!! not at definition time. Killing it here would clear it before the
	!! player could ever click, same stray-killvar bug as the tattoo/
	!! piercing pickers elsewhere in this mod.
end

